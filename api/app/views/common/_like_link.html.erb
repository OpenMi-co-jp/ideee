<div class='like-click idea <%= 'clicked' if current_user&.like?(object) %>' data-id='<%= object.id %>' data-type='<%= object.model_name %>'>
  <div class='likes-column'>
    <div class='like-image'>
      <%= embedded_svg "like-heart.svg", alt: 'いいね数' %>
    </div>
    <div class='likes-count js-like-count'>
      <%= object.likes.length %>
    </div>
  </div>
</div>
