<footer>
  <div class="container orange-action-back">
    <div class="footer-body mt-3 p-3">
      <ul class="row">
        <li class='col l3 s12'>
          <%= link_to root_path, class:'footer-logo' do %>
            <%= image_tag 'footer-logo.svg', class: "ml-3", alt: "ideee", loading: "lazy" %></li>
          <% end %>
        <li class='col l9 s12'>
          <ul class='row left'>
            <li class='col l2 m6 s12 offset-l5'><%= link_to 'アイデアマン', search_users_path(key: 'idea_man'), class: "white-text" %></li>
            <li class='col l2 m6 s12'><%= link_to 'エンジニア', search_users_path(key: 'engineer'), class: "white-text" %></li>
            <li class='col l3 m6 s12'><%= link_to 'ユーザーランキング', users_path, class: "white-text" %></li>
            <%# ディスカッションを追加 %>
            <%# <li><a class="white-text" href="#!">ディスカッション</a></li> %>
          </ul>
        </li>
      </ul>
      <ul class="mt-2 row">
        <li class='col l11 s12 mt-3'>
          <ul class='row footer-list right'>
            <li class='col l2 s12'><%= link_to 'アイディーについて', about_path, class: "white-text" %></li>
            <li class='col l2 s12'><%= link_to 'アイデアの探し方', how_to_find_idea_path, class: "white-text" %></li>
            <li class='col l2 s12'><%= link_to 'プライバシーポリシー', privacy_policy_path, class: "white-text" %></li>
            <li class='col l1 s12'><%= link_to '利用規約', terms_of_service_path, class: "white-text" %></li>
            <li class='col l1 s12'><%= link_to 'よくある質問', frequent_questions_path, class: "white-text" %></li>
            <li class='col l1 s12'><%= link_to '運営者', "https://naruhiro-portfolio.firebaseapp.com/", class: "white-text", target: :_blank %></li>
            <%# TODO:募金の説明を追加 %>
            <%# <li><a class="white-text" href="#!">募金について</a></li> %>
          </ul>
        </li>
      </ul>
      <div class="c-share footer-share">
        <ul class="c-share__flex">
          <li class="c-share__box">
            <%= sns_share_icon("twitter") %>
          </li>
          <li class="c-share__box">
            <%= sns_share_icon("facebook") %>
          </li>
          <li class="c-share__box">
            <%= sns_share_icon("line") %>
          </li>
          <li class="c-share__box">
            <%= sns_share_icon("hatebu") %>
          </li>
        </ul>
        <p class="c-share__text footer-share__text">＼ シェア ／</p>
      </div>
    </div>
  </div>
  <div class="copyright gray-5">
    ©️ <%= Time.current.year %> ﾌﾟﾛﾀﾞｸﾄｴﾝｼﾞﾆｱ
  </div>
</footer>
