<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content="@1026NT" />
<meta property="og:title" content="<%= full_title(yield(:title)) %>" />
<meta property="og:url" content="<%= request.url %>" />
<meta property="og:description"
  content="<%= content_for?(:description) ? yield(:description) : 'アイデアと開発者のマッチングアプリ' %>" />
<meta property="og:image"
  content="<%= content_for?(:image_url) ? yield(:image_url) : full_url('/assets/images/ideee-tech-logo.png') %>" />
