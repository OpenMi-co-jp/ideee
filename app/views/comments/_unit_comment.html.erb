<div class='c-unit-comment'>
  <div class="flex">
    <% if owned %>
      <%= render 'comments/comment_time', created_at: comment.created_at %>
      <div class='c-unit-comment__info'>
        <%= render 'comments/comment_description', comment: comment  %>
        <%= render 'comments/option', comment: comment %>
      </div>
    <% else %>
      <div class='c-unit-comment__user'>
        <%= link_to user_path(comment.user_id) do %>
          <%= user_icon(User.find(comment.user_id), size: 'small') %>
        <% end %>
      </div>
      <div>
        <div class='c-unit-comment__user--name'><%= User.find(comment.user_id).name %></div>
        <div class='c-unit-comment__info'>
          <%= render 'comments/comment_description', description: comment.description %>
          <div class='c-unit-comment__options'>
            <%= render "common/like", object: comment, render_to: 'comments/comment_heart' %>
          </div>
        </div>
      </div>
      <%= render 'comments/comment_time', created_at: comment.created_at %>
    <% end %>
  </div>
</div>
