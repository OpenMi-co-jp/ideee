<div class='c-comment-description'>
  <% if item.class.model_name.collection == 'comments' %>
    <div class="c-comment-description__text <%= 'compact' if item.over_length? %>">
      <%= simple_format(text_url_to_link(item.description), {}, sanitize: false) %>
    </div>
    <% if item&.over_length? %>
      <p class="c-comment-description__option js-comment-shorten-trigger">続きを読む</p>
    <% end %>
  <% else %>
    <div class="c-comment-description__action_text">
      <%= item.content %>
    </div>
  <% end %>
</div>
