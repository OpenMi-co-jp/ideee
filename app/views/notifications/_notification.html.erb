<div class="p-notification__container">
  <div class="p-notification__user_icon">
    <%= user_icon(notification.visitor, size: 'small') %>
  </div>
  <div class="p-notification__message">
    <%= link_to "#{truncate(notification.visitor.name)}", user_path(notification.visitor_id), class: "p-notification__message__link" %>
      さんが「
    <%= link_to "#{truncate(notification.idea.name)}", idea_path(notification.idea_id), class: "p-notification__message__link" %>
    <% if notification.action_like? %>
      」にLikeしました。
    <% elsif notification.action_comment? %>
      」にコメントしました。
      <%= content_tag(:p, "「#{truncate(notification.comment.description)}」", class: "p-notification__message__comment") %>
    <% end %>
    <%= content_tag(:p, "#{notification.created_at.time.to_s(:long)}", class: "p-notification__message__date") %>
  </div>
</div>
<li class="divider" tabindex="-1"></li>
