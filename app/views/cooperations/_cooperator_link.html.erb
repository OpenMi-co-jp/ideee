<% if idea.cooperation_ongoing? %>
  <% if current_user&.cooperation_joined?(idea) %>
    <%= link_to(
      t('default.cooperation_cancel'),
      '#modal_cooperation_cancel',
      data: { turbolinks: false },
      class: 'waves-effect waves-light btn-large grey darken-2 modal-trigger',
      id: 'modal-trigger-cooperation-cancel',
    )%>
    <%= render 'cooperations/modal',
      modal_id: 'modal_cooperation_cancel',
      heading: 'この開発への参加を辞退しますか？',
      name: t('default.cooperation_cancel'),
      path: cooperation_path(idea_id: idea),
      method: :delete,
      color: 'grey darken-2'
    %>
  <% else %>
    <%= link_to t('default.cooperation_join'), cooperation_join_confirm_idea_path(idea), class: 'waves-effect waves-light btn-large orange darken-4'%>
  <% end %>
<% end %>
