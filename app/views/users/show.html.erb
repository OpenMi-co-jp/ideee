<div class='p-user-show'>
  <div class="row">
    <div class="col s12 l3">
      <div class="c-user-icon-info">
        <div class='c-user-icon-info__icon'><%= user_icon(@user, size: 'large') %></div>
        <h4 class='c-user-icon-info__name'><%= @user&.name %></h4>
        <h5><%= @user&.point %></h5>
        <p class='c-user-icon-info__contributions'>Contributions</p>
        <p class='c-user-icon-info__created-date'><%= "作成日：#{l @user.created_at}" %></p>
      </div>
      <div class='c-user-urls'>
        <div class="c-user-urls__item">
          <% if @user&.twitter_id.present? %>
            <%= link_to twitter_url(@user&.twitter_id), target: '_blank', rel: 'nofollow noopener noreferrer' do %>
              <%= embedded_svg "twitter_icon.svg", class: "c-user-urls__item--twitter" %>
            <% end %>
          <% else %>
            <%= embedded_svg "twitter_icon.svg", class: "c-user-urls__item--twitter gray" %>
          <% end %>
        </div>
        <div class="c-user-urls__item">
          <% if @user.site_url.present? %>
            <%= link_to @user.site_url, target: '_blank', rel: 'nofollow noopener noreferrer' do %>
              <i class="material-icons medium orange-soft">link</i>
            <% end %>
          <% else %>
            <i class="material-icons small gray-3">link</i>
          <% end %>
        </div>
      </div>
    </div>
    <div class="col s12 l9">
      <div class="row">
        <div class="col s10">
          <%= user_definiton(@user) %>
        </div>
      </div>
      <% if @user.description.present? %>
        <div class="c-user-content mb-2">
          <%== simple_format(text_url_to_link(@user.description), {}, sanitize: false) %>
        </div>
      <% end %>
      <% if own_user_checked(@user) %>
        <%= link_to '編集', edit_user_registration_path(@user.id), class: 'mw-3' %>
      <% end %>
    </div>
  </div>
  <nav class="nav-extended c-nav-var">
    <div class="nav-content c-nav-var__content">
      <ul class="tabs tabs-transparent">
        <li class="tab c-nav-var__tab"><a class="active" href="#tab1">アイデアリスト</a></li>
        <li class="tab c-nav-var__tab"><a href="#tab2">ハート</a></li>
        <li class="tab c-nav-var__tab"><a href="#tab3">コメント</a></li>
      </ul>
    </div>
  </nav>
  <div id="tab1" class="col s12">
    <div class="row">
      <div class="col s12 <%= own_user_checked(@user) ? 'l8' : 'l12' %>">
        <% if @user.ideas.published.present? %>
          <%= render 'common/column_board', ideas: @ideas %>
          <%= paginate @ideas %>
        <% else %>
          <h5 class='no_idea_posted'>まだアイデアが投稿されていません</h5>
        <% end %>
      </div>
      <% if own_user_checked(@user) %>
        <div class="col s12 l4">
          <% if @user.ideas.drafts.present? %>
            <h4>下書きアイデア</h4>
            <%= render 'common/simple_board', ideas: @user.ideas.drafts %>
          <% else %>
            <h5 class='no_draft_posted'>まだ下書きがありません</h5>
            <p class='gray-3'>※下書きはあなたにしか見えません</p>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
  <div id="tab2" class="col s12">
    <% if @user.likes.present? %>
      <%= render 'common/column_board', ideas: @user.likes.map{|n| Idea.find_by(id: n.idea_id) }.uniq %>
    <% else %>
      <h5>まだアイデアにハートを送っていません</h5>
    <% end %>
  </div>
  <div id="tab3" class="col s12">
    <% if @user.comments.present? %>
      <%= render 'common/column_board', ideas: @user.comments.map{|n| Idea.find_by(id: n.idea_id) }.uniq %>
    <% else %>
      <h5>まだアイデアにコメントをしていません</h5>
    <% end %>
  </div>
  <%= render 'common/fund_link', object: @user %>
  <%= render 'users/show/lead_to_post' if own_user_checked(@user) %>
</div>
