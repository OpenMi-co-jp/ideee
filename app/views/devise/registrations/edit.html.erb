<div class="sign-form">

  <h4><%= t '.title' %></h4>

  <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>

    <div class="row">
      <div class="user-type-column col s12 l4">
        <div class="field">
          <%= f.label :icon %>
          <%= image_tag '', id: "avatar_img_prev", class:"disabled user"%>
          <div class='present-img'>
            <% if resource.icon.file.present? || resource.remote_url.present? %>
              <%= user_icon(@user, size: 'large') %>
            <% end %>
          </div>
          <%= f.file_field :icon, accept: 'image/png,image/jpeg', id: "post-img", class: 'mh-3' %>
        </div>
      </div>

      <div class="col s12 l8">
        <div class="field">
          <%= f.label :name, class: 'required' %><br />
          <%= f.text_field :name, autofocus: true, autocomplete: "name", placeholder: 'お名前' %>
        </div>

        <div class="field">
          <%= f.label :email, class: 'required' %><br />
          <%= f.email_field :email, autofocus: true, autocomplete: "email", placeholder: 'example@example.com' %>
        </div>

        <div class="field">
          <%= f.label :description %><br />
          <%= f.text_area :description, class: 'user-content', placeholder: 'ユーザーの説明' %>
        </div>

        <div class="field">
          <%= f.label :definition, class: 'required' %><br />
          <div class="input-field">
            <%= f.select :definition, User.definitions.keys.map { |k| [I18n.t("enums.user.definition.#{k}"), k] }, { include_blank: '自分のタイプを選んでください' } %>
          </div>
        </div>

        <div class="field">
          <%= f.label :twitter_id %><br />
          <%= f.text_field :twitter_id, placeholder: 'Twitter ID' %>
        </div>

        <div class="field">
          <%= f.label :site_url %><br />
          <%= f.text_field :site_url, placeholder: 'サイトURL' %>
        </div>

        <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
          <div>メールの確認待ち: <%= resource.unconfirmed_email %></div>
        <% end %>

        <%= f.submit class: 'btn orange-action-back mh-3' %>
      </div>
    </div>

  <% end %>

  <%# TODO: 休会対応をするときに変更する %>
  <!---
  <h3><%= t '.cancel' %></h3>

  <%= button_to 'cancel', registration_path(resource_name), data: { confirm: "Are you sure?" }, method: :delete %>
  -->
</div>
