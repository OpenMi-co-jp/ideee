<% if current_user && !current_user.own?(object) %>
  <% if current_user&.like?(object) %>
    <%= render 'common/like_link', object: object, clicked: 'clicked' %>
  <% else %>
    <%= render 'common/like_link', object: object, clicked: nil %>
  <% end %>
<% else %>
  <%= link_to '#modal_before_login', data: { turbolinks: false }, class: "modal-trigger-login #{own_object?(object)}" do %>
    <div class='likes-column'>
      <p class='like-image'>
        <%= embedded_svg "like-heart.svg" %>
      </p>
      <p class='likes-count'>
        <%= object.likes_num %>
      </p>
    </div>
  <% end %>
<% end %>
