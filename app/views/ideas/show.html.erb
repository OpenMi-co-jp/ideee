<%# OGP %>
<% unless @idea.draft %>
  <% set_meta_tags og: {
    title: @idea.name,
    image: return_ogp_url(@idea.name),
    description: strip_tags(@idea.note.to_s).gsub(/[\n]/, "").strip.truncate(120)
  } %>
<% end %>

<div class='idea-show'>
  <div class='row'>
    <div class='idea-column-img col l3 s12'>
      <% if @idea.draft %>
        <div class='chip'><%= t('default.draft') %></div>
      <% end %>
      <%= image_set(@idea) %>
      <p class='idea-created gray-3'><%= "作成日: #{l @idea.created_at}" %></p>
      <% unless @idea.draft %>
        <div class="c-share">
          <ul class="c-share__flex idea-show__share-flex">
            <li class="c-share__box idea-show__share-box">
              <%= sns_share_icon("twitter") %>
            </li>
            <li class="c-share__box idea-show__share-box">
              <%= sns_share_icon("facebook") %>
            </li>
            <li class="c-share__box idea-show__share-box">
              <%= sns_share_icon("line") %>
            </li>
            <li class="c-share__box idea-show__share-box">
              <%= sns_share_icon("hatebu") %>
            </li>
          </ul>
          <p class="c-share__text">＼ シェア ／</p>
        </div>
        <div class="c-url-copy" onclick="M.toast({html: 'コピーしました', classes: 'orange lighten-3 rounded'})">
          <i class="material-icons">content_copy</i>
          <%= tag.p '＼ URL コピー ／' %>
        </div>
      <% end %>
    </div>
    <div class='idea-status-column col l9 s12'>
      <div class='idea-name orange-action'>
        <%= @idea.name %>
      </div>

      <div class='row gray-4'>
        <div class='col l10 s12'>
          <div class='row'>
            <p class='col l6 s12 grid-middle'>
              <%= user_definiton(@idea.user) %>
            </p>
            <div class='col l6 s12 flex'>
              <%= link_to user_path(@idea.user.id) do %>
                <% user_icon(@idea.user, size: 'small') %>
              <% end %>
              <p class='grid-middle'>
                <%= @idea.user.name %>
              </p>
            </div>
          </div>

          <div class='status-info'>
            <div class="status-info__day">
              <%= "更新日：#{l @idea.updated_at}" %>
            </div>
            <div class="status-info__eye">
              <%= image_tag 'icons/eye.svg' %>
              <%= @idea.view %>
            </div>
            <div class='status-info__comment', id="comments_count">
              <%= image_tag 'icons/comment.svg' %>
              <p><%= @idea.comments_num %></p>
            </div>
            <div class="status-info__vote <%= @idea.difficulty %>">
              <%= render 'difficultys/vote', object: @idea %>
            </div>
            <% if current_user&.own?(@idea) %>
              <div class='status-info__time'>
                <%= "平均ページ滞在時間: #{Time.at(@time_on_page.to_i).utc.strftime('%X')}" %>
              </div>
            <% end %>
          </div>
          <%= render 'tags/links', object: @idea %>
        </div>
        <div class='col s12 l2 flex-end'>
          <%= render "common/like", object: @idea %>
        </div>
      </div>

      <div class='idea-content mb-2'>
        <% if current_user || @idea.approved? %>
          <%== @idea.note %>
        <% else %>
          <%= strip_tags(@idea.note.to_s).gsub(/[\n]/, "").strip.truncate(120) %>
          <div class='white p-3'>
            <div class='flex login-guidance'>
              <div class='nav-item'>
                <%= link_to 'ユーザー登録', new_user_registration_path, class: 'waves-effect btn orange-action-back' %>
              </div>
              <div class='flex'>
                <p class='grid-middle'>or</p>
                <%= link_to 'ログイン', new_user_session_path, class: 'grid-middle' %>
                <p class='grid-middle p-0'>して確認</p>
              </div>
              <p>
            </div>
          </div>
        <% end %>
        <% if @idea.approved? %>
          <b><%= t("activerecord.attributes.idea.product_url") %></b>
          <%== simple_format(text_url_to_link(@idea.product_url), {}, sanitize: false) %>
        <% end %>
      </div>
      <% if current_user&.own?(@idea) %>
        <% if @idea.draft %>
          <%= link_to t('default.publish'), publish_idea_path(@idea), method: :post, data: { confirm: '公開してもよろしいですか？' }, class: 'btn orange-action-back'%>
        <% end %>
        <%= link_to '編集', edit_idea_path(@idea), class: 'mw-3' %>
        <%= link_to '削除', idea_path(@idea), method: :delete, data: { confirm: '削除してもよろしいですか？' }, class: 'mw-3' %>
      <% end %>
    </div>
  </div>

  <hr class='gray-3'>

  <% unless @idea.draft %>
    <%= render 'comments/board', object: @idea %>
    <%= render 'comments/form' %>
  <% end %>
  <%= render 'common/fund_link', object: @idea %>
  <%= render 'ideas/show/vote_modal' %>
</div>
