<div class='user-show'>
  <div class="row">
    <div class="col s12 l3">
      <div class="user-type-column">
        <div class='mh-3'><%= user_icon(@user, size: 'large') %></div>
        <h4 class='mh-3'><%= @user&.name %></h4>
        <h5><%= @user&.point %></h5>
        <p class='gray-3'>Contributions</p>
        <p class='gray-3 mh-3'><%= "作成日：#{l @user.created_at}" %></p>
      </div>
      <div class='user-urls'>
        <div class="share-box">
          <% if @user&.twitter_id.present? %>
            <%= link_to twitter_url(@user&.twitter_id), target: '_blank', rel: 'nofollow noopener noreferrer' do %>
              <%= image_tag "twitter_icon.svg", class: "twitter-share", alt: "Twitter share"%>
            <% end %>
          <% else %>
            <%# TODO: pngからsvgに切り替えて色の切り替えをするようにする %>
            <%= image_tag "twitter_gray_icon.png", class: "twitter-share", alt: "Twitter share"%>
          <% end %>
        </div>
        <div class="share-box grid-middle">
          <% if @user.site_url.present? %>
            <%= link_to @user.site_url, target: '_blank', rel: 'nofollow noopener noreferrer' do %>
              <i class="material-icons medium orange-soft">link</i>
            <% end %>
          <% else %>
            <i class="material-icons small gray-3">link</i>
          <% end %>
        </div>
      </div>
    </div>
    <div class="col s12 l9">
      <div class="">
        <div class="row">
          <div class="col s10">
            <%= user_definiton(@user) %>
          </div>
        </div>
      </div>
      <% if @user.description.present? %>
        <div class="user-content mb-2">
          <%== simple_format(text_url_to_link(@user.description), {}, sanitize: false) %>
        </div>
      <% end %>
      <% if own_user_checked(@user) %>
        <%= link_to '編集', edit_user_registration_path(@user.id), class: 'mw-3' %>
      <% end %>
    </div>
  </div>
  <% if @user.ideas.present? %>
    <h4>アイデア</h4>
    <%= render 'common/column_board', ideas: @user.ideas %>
  <% else %>
    <h4 class='no_idea_posted'>まだアイデアが投稿されていません</h4>
  <% end %>
  <%= render 'common/fund_link', object: @user %>
  <%= render 'users/show/lead_to_post' if own_user_checked(@user) %>
</div>
