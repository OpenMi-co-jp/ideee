<div class='like-click <%= clicked %>', data-id='<%= object.id %>'>
  <div class='likes-column'>
    <div class='flex'>
      <div class='like-image'>
        <%= image_tag "icons/like-icon.svg", size: '45x45', class: 'like-svg' %>
      </div>
      <div class='likes-count grid-middle' data-likes='<%= object.likes_num %>'>
        <%= object.likes_num %>
      </div>
    </div>
  </div>
</div>
