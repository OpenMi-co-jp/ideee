<div class='mobile-idea-status'>
  <div class='row gray-4'>
    <div class='col s12'>
      <div class='row'>
        <p class='col s6'>
          <%= user_definiton(idea.user) %>
        </p>
        <div class='col s6 flex'>
          <%= link_to user_path(idea.user_id) do %>
            <% user_icon(idea.user, size: 'small') %>
          <% end %>
          <p class='grid-middle'>
            <%= idea.user.name %>
          </p>
        </div>
      </div>

      <div class='c-mobile-status-info'>
        <div class="c-mobile-status-info__day">
          <%= "更新日：#{l idea.updated_at}" %>
        </div>
        <div class="c-mobile-status-info__eye">
          <%= image_tag 'icons/eye.svg', loading: "lazy" %>
          <p><%= idea.view %></p>
        </div>
        <div class='c-mobile-status-info__comment', id="comments_count">
          <%= image_tag 'icons/comment.svg', loading: "lazy" %>
          <p><%= idea.comments_num %></p>
        </div>
      </div>
      <div class='c-mobile-status-info__time'>
        <%= "平均ページ滞在時間: #{Time.at(time_on_page.to_i).utc.strftime('%X')}" %>
      </div>
      <div class='c-mobile-status-info'>
        <div class="c-mobile-status-info__vote <%= idea.difficulty %>">
          <%= render 'difficultys/vote', object: idea %>
        </div>
        <%= render "common/like", object: idea, render_to: 'common/like_link' %>
      </div>
      <%= render 'tags/links', object: idea %>
    </div>
  </div>
</div>
