<div class="p-notification__container">
  <div class="p-notification__user_icon">
    <%= link_to user_path(id: notification.visitor_id, notification: notification) do %>
      <%= user_icon(notification.visitor, size: 'small') %>
    <% end %>
  </div>
  <div class="p-notification__message">
    <%= link_to "#{truncate(notification.visitor.name)}", user_path(id: notification.visitor_id, notification: notification), class: "p-notification__message--link" %>
      さんが
    <%= link_to "#{truncate(notification.idea.name)}", idea_path(id: notification.idea_id, notification: notification), class: "p-notification__message--link" %>
    <% if notification.action_like? %>
      にハートを送りました。
    <% elsif notification.action_comment? %>
      にコメントしました。
      <%= content_tag(:p, "「#{truncate(notification.comment.description)}」", class: "p-notification__message--comment") %>
    <% end %>
    <%= content_tag(:p, "#{notification.created_at.time.to_s(:long)}", class: "p-notification__message--date") %>
  </div>
</div>
<li class="divider" tabindex="-1"></li>
