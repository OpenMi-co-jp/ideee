<% if current_user && !current_user.own?(object) %>
  <% if current_user&.like?(object) %>
    <%= render 'common/like_link', object: object, clicked: 'clicked' %>
  <% else %>
    <%= render 'common/like_link', object: object, clicked: nil %>
  <% end %>
<% else %>
  <%= link_to '#modal_before_login', data: { turbolinks: false }, class: "modal-trigger-login #{own_object?(object)}" do %>
    <div class='likes-column'>
      <div class='like-image'>
        <svg width="18" height="19" viewBox="0 0 18 19" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M8.99995 3.30697C6.91679 -0.802354 0.950708 0.831028 1.00031 6.20418C1.04991 11.4295 6.87427 13.5655 8.99995 18C11.1256 13.5655 16.95 11.4295 16.9996 6.20418C17.0563 0.831028 11.0831 -0.802354 8.99995 3.30697Z" fill="#ffffff" stroke="black" stroke-miterlimit="10" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </div>
      <div class='likes-count'>
        <%= object.like_users.count %>
      </div>
    </div>
  <% end %>
<% end %>
