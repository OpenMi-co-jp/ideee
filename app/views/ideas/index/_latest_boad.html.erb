<div class='latest-boad'>
  <div class='back-color-board'></div>
  <div class='main-board'>
    <div class='latest-title-colum'>
      <p class='icon-mark'>🎉</p>
      <b class='latest-title'>最近実現したアイデア</b>
    </div>
    <div class='latest-idea-colum'>
      <% if @latest_ideas%>
        <% @latest_ideas.each do |idea| %>
          <a href="<%= idea_path(idea.id) %>" %>
            <div class='idea-picture-column'>
              <div class= 'idea-img'>
                <%= image_set(idea) %>
              </div>
              <div class= 'time-label'>
                <%= idea.created_time %>
              </div>
              <%= idea.name %>
              <%= idea.view %>
            </div>
          </a>
        <% end %>
      <% end %>
    </div>
  </div>
</div>
