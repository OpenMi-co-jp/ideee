<div class="sign-form row">
  <div class="col s12 l6">
    <h2 class='orange-action'><%= t '.message' %></h2>
    <p>開発して欲しいアイデアを投稿するプラットフォーム</p>
    <p>アイデアに対して反応が見れる！</p>
    <p>作りたいアイデアに出会える！</p>
    <p>投げ銭で応援もできる！</p>
    <%= render "devise/shared/twitter_share" %>
  </div>
  <div class="col s12 l6">
    <h2><%= t '.title' %></h2>

    <%= render "devise/shared/omniauth_links" %>
    <%= form_with(model: @user, url: user_registration_path, id: 'new_user', local: false) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>

      <div class="field">
        <%= f.label :email %><br />
        <%= f.email_field :email, autofocus: true, autocomplete: "email", placeholder: 'ideee@example.com', class: 'validate', required:'required'%>
        <span class="helper-text" data-error="正しい形式のメールアドレスを入力してください。"></span>
      </div>

      <div class="field">
        <%= f.label :password %>
        <% if @minimum_password_length %>
        <em>(<%= @minimum_password_length %> 文字以上のパスワードを使用してください)</em>
        <% end %><br />
        <%= f.password_field :password, autocomplete: "new-password", placeholder: 'password', class: 'validate', data:{"min-length": @minimum_password_length} %>
        <span class="helper-text" data-error="<%= @minimum_password_length %>文字以上のパスワードを入力してください。"></span>
      </div>

      <div class="field">
        <%= f.label :password_confirmation %><br />
        <%= f.password_field :password_confirmation, autocomplete: "new-password", placeholder: 'confirm password', class: 'validate', data:{"min-length": @minimum_password_length} %>
        <span class="helper-text" data-error="<%= @minimum_password_length %>文字以上のパスワードを入力してください。"></span>
      </div>

      <%= f.button t('.submit'), id: 'new_user_submit', type:'button', class: 'btn orange-action-back mh-1' %>
      <%= render 'devise/shared/agreed_note', submit: t('.submit') %>
    <% end %>

    <%= render "devise/shared/links" %>
  </div>
</div>
