<div class='idea-colum-board'>
  <% ideas.each_with_index do |idea, i| %>
    <div class='flex'>
      <h5 class='italic'>
        <%= i+1 %>
      </h5>
      <div class='idea-column border-line pl-3 row'>
        <%= link_to idea_path(idea.id), class:'col l2 m2 s12' do %>
          <div class='idea-column-image mb-2'>
            <div class='idea-img-boader gray-2'>
              <%= image_set(idea) %>
            </div>
          </div>
        <% end %>
        <div class='idea-column-body mb-2 col l8 m8 s12'>
          <%= link_to idea_path(idea.id) do %>
            <b class='idea-name orange-action'><%= idea.name %></b>
          <% end %>
          <div class='idea-info'>
            <div class='idea-status row gray-3'>
              <p class='col s12 l5 p-0'><%= "投稿日 #{idea.created_time}" %></p>
              <div class='col s3 l2 flex p-0'><%= image_tag 'icons/comment.svg', class:'icon-size gray-4' %><p class='gray-5 ml-2'><%= idea.comments.length %></p></div>
              <div class='col s3 l2 flex p-0'><%= image_tag 'icons/eye.svg', class:'icon-size gray-4' %><p class='gray-5 ml-1'><%= idea.view %></p></div>
              <div class='col s3 l2 flex p-0'><%= image_tag 'icons/difficulty.svg', class:'icon-size gray-4' %><p class='gray-5 ml-2'><%= idea.difficulty %></p></div>
            </div>
            <div class='flex-end'>
              <%= link_to user_path(idea.user.id), class: 'max-width' do %>
                <% user_icon(idea.user, size: 'small') %>
              <% end %>
              <p class='grid-middle p-0 user-def'>
                <%= user_definiton(idea.user, ver='short') %>
              </p>
            </div>
          </div>
        </div>
        <div class='like-column col l2 m2 s12'>
          <%= render "common/like", object: idea %>
        </div>
      </div>
    </div>
  <% end %>
</div>
