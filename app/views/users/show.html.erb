<div class='boad'>
  <h1>プロフィール</h1>
  <table>
      <thead>
        <tr class='mb-3'>
          <th>アイコン</th>
          <th>名前</th>
          <th>メールアドレス</th>
          <th>プロフィール</th>
          <th>作成日</th>
          <th>タイプ</th>
          <th colspan="3"></th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td><%= user_icon(@user) %></td>
          <td><%= @user&.name %></td>
          <td><%= @user&.email %></td>
          <td><%= @user&.description %></td>
          <td><%= l @user.created_at, format: :long %></td>
          <td><%= I18n.t("enums.user.definition.#{@user.definition}") %></td>
          <td><%= twitter_url(@user&.twitter_id) %></td>
          <% @user.ideas.each do |i| %>
            <td><%= i.name %></td>
          <% end %>
          <td><%= link_to 'Edit', edit_user_registration_path(@user.id) %></td>
          <%# <%= link_to 'Destroy', user_registration_path(@user.id), method: :delete, data: { confirm: 'Are you sure?' } %>
        </tr>
      </tbody>
    </table>
</div>
