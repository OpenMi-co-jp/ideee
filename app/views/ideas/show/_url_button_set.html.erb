<% if @idea["#{item}"].present? && item == 'github_url'%>
  <div class="mh-3">
    <button class="btn orange-action-back mh-3" onClick="window.open('<%= @idea["#{item}"] %>','_blank')">
      <%= embedded_svg 'icons/mark-github.svg', class: 'idea-date--clock' %>
      <span style="text-transform:none;">
        GitHubを確認
      </span>
    </button>
  </div>
<% else %>
  <div class="mh-3">
    <button class="btn orange-action-back mh-3" onClick="window.open('<%= @idea["#{item}"] %>','_blank')">
      <i class="material-icons">phonelink</i>
      <span style="text-transform:none;">
        アプリURL
      </span>
    </button>
  </div>
<% end %>
