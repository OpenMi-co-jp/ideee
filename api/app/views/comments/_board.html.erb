<div class="p-comment-board yellow-soft-back ph-1">
  <h4 class='p-comment-board__title'><%= t(".#{item_class}.title") %></h4>
  <div class="divider" tabindex="-1"></div>
  <% if items.length > 0 %>
    <% items.each do |item| %>
      <div class="p-comment-board__item <%= 'own-comment' if current_user&.own?(item) %>" id="<%= item_class %>-<%= item.id %>">
        <%= render 'comments/unit_comment', item: item %>
      </div>
    <% end %>
  <% else %>
    <h6 class='mw-4 pt-2'><%= t(".#{item_class}.no_item_message") %></h6>
  <% end %>
  <div id="js-<%= item_class %>"></div>
</div>
