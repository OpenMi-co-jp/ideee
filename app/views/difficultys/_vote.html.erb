<% if current_user %>
  <% if current_user&.voted?(object) %>
    <%# すでに投票していたらそのタグの種類を検索する %>
    <%= link_to difficulty_tag(object), search_ideas_path(difficulty: object.difficulty_before_type_cast) %>
  <% else %>
    <%# 投票のためのモーダル出現 %>
    <%= link_to difficulty_tag(object),
      '#modal_difficulty',
      data: { turbolinks: false },
      class: 'modal-trigger',
      id: 'modal-trigger-difficulty' %>
  <% end %>
<% else %>
  <%# ログイン前はログインのためのモーダル出現 %>
  <%= link_to '#modal_before_login', data: { turbolinks: false }, class: "modal-trigger-login" do %>
    <%= difficulty_tag(object) %>
  <% end %>
<% end %>
