<%# メッセージにリアクション機能をつけるまでの暫定対応 %>
<% if object.class.model_name.collection == 'comments' %>
  <div class='like-click comment <%= 'clicked' if current_user && current_user&.like?(object) %>' data-id='<%= object.id %>'>
    <div class='c-comment-heart'>
      <div class='c-comment-heart__image'>
        <%= embedded_svg "like-heart.svg" %>
      </div>
      <% if object.likes.length.positive? %>
        <div class='c-comment-heart__count js-like-count'>
          <%= object.likes.length %>
        </div>
      <% end %>
    </div>
  </div>
<% end %>
