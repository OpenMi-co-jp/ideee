<div class='idea-colum-board'>
  <% ideas.each do |idea| %>
    <%= link_to idea_path(idea.id) do %>
      <div class='idea-column z-depth-3'>
        <div class='idea-picture-column-small'>
          <div class='idea-img'>
            <%= image_set(idea) %>
          </div>
        </div>
        <div class='idea-column-body'>
          <b class='idea-name'><%= idea.name %></b>
          <div class='idea-info'>
            <div class='idea-status'>
              <%= "投稿日: #{idea.created_time}" %>
              <i class="material-icons">remove_red_eye</i><%= idea.view %>
            </div>
            <div class='idea-belong'>
              <%= link_to user_path(idea.user.id) do %>
                <% user_icon(idea.user, size: 'small') %>
              <% end %>
              <p class='user-name'>
                <%= idea.user.name %>
              </p>
            </div>
          </div>
        </div>
        <div class='like-column'>
          <%= render "common/like", object: idea %>
        </div>
      </div>
    <% end %>
  <% end %>
</div>
