<div class="user-board gray-1-back pl-3">
  <div class='flex mh-3'>
    <p class='icon-mark gray-2-back'><%= icon %></p>
    <b class='board-title c-featured-users__title'><%= title %></b>
    <%= link_to path, class: 'more-info mt-3 flex gray-5' do %>
      <i class="material-icons">chevron_right</i>もっと見る
    <% end %>
  </div>
  <%= render 'common/partial_users', users: users %>
</div>
