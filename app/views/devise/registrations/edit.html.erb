<div class="sign-form">

  <h4><%= t '.title' %></h4>

  <%= form_with(model: @user, url: user_registration_path, id: 'edit_user', local: false) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>

    <div class="row">
      <div class="c-user-icon-info col s12 l4">
        <div class="field">
          <%= f.label :icon %>
          <%= image_tag '', id: "avatar_img_prev", class:"disabled user", loading: "lazy" %>
          <div class='present-img'>
            <% if resource.icon.file.present? || resource.remote_url.present? %>
              <%= user_icon(@user, size: 'large') %>
            <% end %>
          </div>
          <%= f.file_field :icon, accept: 'image/png,image/jpeg', id: "post-img", class: 'mh-3' %>
        </div>
      </div>

      <div class="col s12 l8">
        <div class="field input-field">
          <%= f.text_field :name, autofocus: true, autocomplete: "name", placeholder: 'お名前', data: { length: 30 }, class: 'validate', required:'required active' %>
          <%= f.label :name, class: 'required active' %>
          <%= between_length_invalid_text(30) %>
          <span class="helper-text" data-error="1~30文字で入力してください。" data-success="OK"></span>
        </div>

        <div class="field input-field">
          <%= f.email_field :email, autofocus: true, autocomplete: "email", placeholder: 'example@example.com', class: 'validate', required:'required active' %>
          <%= f.label :email, class: 'required active' %>
          <%= email_valid_text %>
        </div>

        <div class="field input-field">
          <%= f.text_area :description, class: 'user-content', placeholder: 'どんな人？' %>
          <%= f.label :description, class: 'active' %>
        </div>

        <div class="field input-field">
          <%= f.select :definition, User.definitions.keys.map { |k| [I18n.t("enums.user.definition.#{k}"), k] }, { include_blank: '自分のタイプを選んでください' }, class: 'validate', required:'required active' %>
          <%= f.label :definition, class: 'required active' %>
          <span class="helper-text" data-error="タイプを選択してください。"></span>
        </div>

        <div class="field input-field">
          <div>
            <%= f.label :twitter_id, class: 'active' %><a class="help-tip twitter-id">?</a>
          </div>
          <%= f.text_field :twitter_id, placeholder: 'Twitter ID' %>
        </div>

        <div class="field input-field">
          <%= f.text_field :site_url, placeholder: 'サイトURL' %>
          <%= f.label :site_url, class: 'active' %>
        </div>

        <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
          <div>メールの確認待ち: <%= resource.unconfirmed_email %></div>
        <% end %>

        <%= f.button id: 'edit_user_submit', type:'button', class: 'btn orange-action-back mh-3' %>
      </div>
    </div>

  <% end %>

  <%# TODO: 休会対応をするときに変更する %>
  <!---
  <h3><%= t '.cancel' %></h3>

  <%= button_to 'cancel', registration_path(resource_name), data: { confirm: "Are you sure?" }, method: :delete %>
  -->
</div>
