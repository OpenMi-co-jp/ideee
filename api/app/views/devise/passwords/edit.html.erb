<div class="sign-form">
  <h2>パスワードを変える</h2>

  <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>
    <%= f.hidden_field :reset_password_token %>

    <div class="field input-field">
      <% if @minimum_password_length %>
        <em>(<%= @minimum_password_length %> 文字以上のパスワードを使用してください)</em><br />
      <% end %>
      <%= f.password_field :password, autofocus: true, autocomplete: "new-password", placeholder: 'password', class: 'validate', data: { 'min-length': @minimum_password_length } %>
      <%= f.label :password, class: 'active' %>
      <%= password_valid_text %>
    </div>

    <div class="field input-field">
      <%= f.password_field :password_confirmation, autocomplete: "new-password", placeholder: 'password', class: 'validate', data: { 'min-length': @minimum_password_length } %>
      <%= f.label :password_confirmation, class: 'active' %>
      <%= password_valid_text %>
    </div>

    <%= f.submit "パスワードを変更", class: 'btn orange-action-back mh-1' %>
  <% end %>

  <%= render "devise/shared/links" %>
</div>
