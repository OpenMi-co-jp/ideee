<%# TODO: rank_listに統合 %>
<div class='idea'>
  <% ideas.each.with_index(1 + (ideas.current_page - 1) * ideas.limit_value) do |idea, i| %>
    <div class='idea__list'>
      <h5 class='idea__num'>
        <%= i %>
      </h5>
      <div class='idea__content'>
        <%= link_to idea_path(idea.id), class: 'c-idea-img', title: 'アイデアのリンク' do %>
          <figure class='c-idea-img__figure'>
            <%= image_set(idea) %>
          </figure>
        <% end %>
        <div class='idea__box'>
          <%= link_to idea_path(idea.id), class: 'idea__name_link', title: 'アイデアのリンク' do %>
            <b class='idea__name orange-action'><%= idea.name %></b>
          <% end %>
          <div class='idea__status gray-3'>
            <div class='idea__time'>
              <%= embedded_svg 'icons/clock.svg', class: 'icon-size gray-4 idea__time--clock', alt: '投稿日' %>
              <p><%= idea.published_time %></p>
            </div>
            <div class='idea__item'>
              <%= image_tag 'icons/comment.svg', class: 'icon-size', loading: "lazy", alt: "コメント数" %>
              <p><%= idea.comments_num %></p>
            </div>
            <% if idea.enough_view? %>
              <div class='idea__item'>
                <%= image_tag 'icons/eye.svg', class: 'icon-size', loading: "lazy", alt: "ビュー数" %>
                <p><%= idea.view %></p>
              </div>
            <% end %>
            <div class='idea__item'>
              <%= image_tag 'like-heart.svg', class: 'icon-size', loading: "lazy", alt: "ハート数" %>
              <p><%= idea.likes_num %></p>
            </div>
            <!-- チーム開発募集中の検索ページ限りteam.members_numの数をアイデア表示に加える -->
            <% if request.path == search_ideas_path && params[:q]&.include?('team_status_eq') && idea&.team&.members_num&.positive? %>
              <div class='idea__item'>
                <i class="material-icons">groups</i>
                <p><%= idea.team.members_num %></p>
              </div>
            <% end %>
            <% if idea.approved? %>
              <div class='idea__item'>
                <i class="material-icons">phonelink</i>
              </div>
            <% end %>
            <div class="idea__detail pc">
              <% unless idea.not_yet? %>
                <div class="idea__detail--vote c-vote-button <%= idea.difficulty %>">
                  <%= idea.difficulty.capitalize %>
                </div>
              <% end %>
              <% user_icon_view ||= 'on' %>
              <% if user_icon_view == 'on' %>
                <%= link_to user_path(idea.user_id), title: 'ユーザーリンク' do %>
                  <% user_icon(idea.user, size: 'small') %>
                <% end %>
                <p class='idea__detail--def'>
                  <%= user_definiton(idea.user, ver = 'short') %>
                </p>
              <% end %>
            </div>
          </div>
          <%= render 'tags/links', object: idea %>
        </div>
        <div class='idea__info'>
          <div class="idea__detail sp">
            <% unless idea.not_yet? %>
              <div class="idea__detail--vote c-vote-button <%= idea.difficulty %>">
                <%= idea.difficulty.capitalize %>
              </div>
            <% end %>
            <%= link_to user_path(idea.user_id), title: 'ユーザーリンク' do %>
              <% user_icon(idea.user, size: 'small') %>
            <% end %>
            <p class='idea__detail--def'>
              <%= user_definiton(idea.user, ver = 'short') %>
            </p>
          </div>
        </div>
      </div>
    </div>
  <% end %>
</div>
