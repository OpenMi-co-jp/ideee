<% if idea.team.nil? %>
  <%= link_to t('default.team.start'), new_team_path(idea_id: idea), class: 'btn orange-action-back'%>
<% elsif idea.team&.status_active? %>
  <%= modal_link('complete','orange-action-back') %>
  <%= render 'teams/modal',
    action: 'complete',
    path: edit_team_path(idea_id: idea),
    method: :post
  %>
<% elsif !idea.team&.status_active? %>
  <%= modal_link('restart','orange-action-back') %>
  <%= render 'teams/modal',
    action: 'restart',
    path: edit_team_path(idea_id: idea),
    method: :post
  %>
<% end %>
