<div class='pc_idea_share'>
  <div class="c-share">
    <ul class="c-share__flex idea-show__share-flex">
      <li class="c-share__box">
        <%= sns_share_icon("twitter") %>
      </li>
      <li class="c-share__box">
        <%= sns_share_icon("facebook") %>
      </li>
      <li class="c-share__box">
        <%= sns_share_icon("line") %>
      </li>
      <li class="c-share__box">
        <%= sns_share_icon("hatebu") %>
      </li>
    </ul>
    <p class="c-share__text">＼ シェア ／</p>
  </div>
  <div class="c-url-copy url-copy-js" onclick="M.toast({html: 'コピーしました', classes: 'orange lighten-3 rounded'})">
    <i class="material-icons">content_copy</i>
    <%= tag.p '＼ URL コピー ／' %>
  </div>
</div>
