<div class="p-room">
  <div class="p-room__input">
    <%= form_with(model: @message, local: false) do |form| %>
      <%= form.rich_text_area :content, placeholder: 'メッセージを送る' %>
      <div class='c-comment-form__btn-area'>
        <%= form.submit t('default.submit'), class: 'btn orange-action-back mh-3 idea-btn' %>
      </div>
    <% end %>
  </div>
</div>
