<%= form_with(model: idea, multipart: true) do |form| %>
  <% if idea.errors.any? %>
    <div id="error_explanation">
      <ul>
        <% idea.errors.each do |error| %>
          <h4>
            <li><%= error.full_message %></li>
          </h4>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class='row'>
    <div class='idea-column-img col s12 l3'>
      <div class="field">
        <%= form.label :icon %>
        <%= image_tag '', id: "avatar_img_prev", class:"disabled"%>
        <div class='present-img'>
          <% if idea.icon.file.present? %>
            <%= image_tag(idea.icon.to_s) %>
          <% end %>
        </div>
        <%= form.file_field :icon, accept: 'image/png,image/jpeg', id: "post-img", class: 'mh-3' %>
      </div>
    </div>
    <div class='idea-status-column col s12 l9'>
      <div class="field">
        <%= form.label :name, class: 'required' %>
        <%= form.text_field :name, placeholder: 'アイデア名' %>
      </div>
      <div class="field">
        <%= form.label :tags_up_to_three %>
        <div class="chips"></div>
        <%= form.hidden_field :tag_list, id: 'tag-hidden-field' %>
      </div>
      <div class="field">
        <%= form.label :note %>
        <%= form.rich_text_area :note %>
      </div>
      <% if idea.cooperation_not_started? || idea.id.nil? %>
        <div class="field">
          <%= form.label :cooperation %>
          <%= form.check_box :cooperation, {}, true, false %>
        </div>
      <% end %>
      <div class="field">
        <%= form.label :product_url %><a class="help-tip product-url ml-2">?</a>
        <%= form.text_field :product_url, placeholder: 'プロダクトのURL' %>
      </div>
      <% if idea.draft || idea.id.nil? %>
        <%= form.submit t('default.save_draft'), class: 'btn orange-soft-back mh-3 idea-btn' %>
      <% end %>
      <% if idea.draft %>
        <%= form.submit t('default.publish'), class: 'btn orange-action-back mh-3 idea-btn' %>
      <% else %>
        <%= form.submit class: 'btn orange-action-back mh-3 idea-btn' %>
      <% end %>
    </div>
  </div>
<% end %>
