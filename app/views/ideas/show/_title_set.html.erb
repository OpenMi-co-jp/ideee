<% if @idea["#{item}"].present? %>
  <div class="mh-3">
    <b><%= t("activerecord.attributes.idea.#{item}") %></b>
    <%= simple_format(text_url_to_link(@idea["#{item}"]), {}, sanitize: false) %>
  </div>
<% elsif item == 'note' && @idea.note.to_s != "<div class=\"trix-content\">\n  \n</div>\n" %>
  <div class="mh-3">
    <%# TODO:1ヶ月後に削除よてい %>
    <b><%= t("activerecord.attributes.idea.#{item}") %></b>
    <%= @idea&.note %>
  </div>
<% end %>
