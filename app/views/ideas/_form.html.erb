<%= form_with(model: idea, multipart: true) do |form| %>
  <% if idea.errors.any? %>
    <div id="error_explanation">
      <ul>
        <% idea.errors.each do |error| %>
          <h4>
            <li><%= error.full_message %></li>
          </h4>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class='row'>
    <div class='idea-column-img col s12 l3'>
      <div class="field">
        <%= form.label :icon %>
        <%= image_tag '', id: "avatar_img_prev", class:"disabled"%>
        <div class='present-img'>
          <% if idea.icon.file.present? %>
            <%= image_tag(idea.icon.to_s) %>
          <% end %>
        </div>
        <%= form.file_field :icon, accept: 'image/png,image/jpeg', id: "post-img", class: 'mh-3' %>
      </div>
    </div>
    <div class='idea-status-column col s12 l9'>
      <div class="field">
        <%= form.label :name, class: 'required' %>
        <%= form.text_field :name, placeholder: 'アイデア名' %>
      </div>
      <div class="field">
        <%= form.label :note %>
        <%= form.rich_text_area :note %>
      </div>
      <div class="field">
        <%= form.label :tag_names_up_to_three %>
        <div class="chips"><input></div>
        <%= form.hidden_field :tag_names, id: 'tag-hidden-field' %>
      </div>
      <%= form.submit class: 'btn orange-action-back mh-3', id: 'idea-btn' %>
    </div>
  </div>
<% end %>
