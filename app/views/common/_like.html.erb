<% if current_user&.like?(object) %>
  <%= link_to "javascript:void(0)",
    class: 'like-click clicked',
    id: "like-idea-#{object.id}",
    data: { id: object.id } do %>
    <div class='likes-column'>
      <%= image_tag "like-icon.svg", size: '45x45', class: 'like-svg' %>
      <div class='likes-count'>
        <%= object.like_users.count %>
      </div>
    </div>
  <% end %>
<% else %>
  <%= link_to "javascript:void(0)",
    class: 'like-click',
    id: "like-idea-#{object.id}",
    data: { id: object.id } do %>
    <div class='likes-column'>
      <%= image_tag "like-icon.svg", size: '45x45', class: 'like-svg' %>
      <div class='likes-count'>
        <%= object.like_users.count %>
      </div>
    </div>
  <% end %>
<% end %>
