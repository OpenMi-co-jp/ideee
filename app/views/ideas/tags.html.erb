<div class='idea-index'>
  <div class='main-board'>
    <h4 class='board-title'>タグ検索</h4>
    <h4 class='board-title'>検索結果 <%= @tagged_ideas.count %>件</h4>
    <%= render 'common/sort_form', keyword: @tag_name, path: tags_ideas_path %>
    <%= render 'common/column_board', ideas: @tagged_ideas %>
    <%= paginate @tagged_ideas %>
  </div>
</div>
