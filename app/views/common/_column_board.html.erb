<div class='idea-colum-board'>
  <% ideas.each_with_index do |idea, i| %>
    <div class='flex'>
      <h4 class='italic'>
        <%= i+1 %>
      </h4>
      <div class='idea-column border-line pl-3 row'>
        <%= link_to idea_path(idea.id), class:'col l2 s12' do %>
          <div class='idea-column-image mb-2'>
            <div class='idea-img-boader gray-2'>
              <%= image_set(idea) %>
            </div>
          </div>
        <% end %>
        <div class='idea-column-body mb-2 col l9 s12'>
          <%= link_to idea_path(idea.id) do %>
            <b class='idea-name orange-action'><%= idea.name %></b>
          <% end %>
          <div class='idea-info'>
            <div class='idea-status gray-3'>
              <%= "投稿日: #{idea.created_time}" %>
              <%= image_tag 'icons/eye.svg', class:'icon-size gray-4 ml-3'%><p class='gray-5'><%= idea.view %></p>
              <%= image_tag 'icons/comment.svg', class:'icon-size gray-4 ml-3'%><p class='gray-5'><%= idea.comments.length %></p>
            </div>
            <div class='flex-end'>
              <%= link_to user_path(idea.user.id) do %>
                <% user_icon(idea.user, size: 'small') %>
              <% end %>
              <p class='grid-middle'>
                <%= user_definiton(idea.user, ver='short') %>
              </p>
            </div>
          </div>
        </div>
        <div class='like-column col l1 s12'>
          <%= render "common/like", object: idea %>
        </div>
      </div>
    </div>
  <% end %>
</div>
