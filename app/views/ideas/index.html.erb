<div class='idea-index'>
  <div class='board'>
    <% unless current_user %>
      <div class='full-pic'>
        <div id='top-page-before-login' class='row'>
          <div class='orange-text'>
            あなたのアイデアを
            <br/>
            エンジニアと盛り上げる
          </div>
          <div id='buttons-on-top-page-before-login' class='mt-4'>
            <%= link_to(
              'ideeeとは',
              '#modal_intro',
              data: { turbolinks: false },
              class: 'waves-effect waves-white white orange-action btn modal-trigger turorial-button',
              id: 'modal-trigger-intro'
            )%>
            <%= link_to '登録する', new_user_registration_path, class: 'waves-effect btn orange-action-back new-user-button' %>
          </div>
        </div>
      </div>
      <div id="modal_intro" class="modal">
        <div class="modal-content">
          <h4>アイデアとエンジニアのマッチングサイト</h4>
          <p><b>アイデアマン：</b>身の回りで困ってることや「あったらいいな」をエンジニアに投げかけることができる</p>
          <p><b>エンジニア：</b>需要のあるアイデアが手に入り、人助けができる</p>
        </div>
        <div class="modal-footer">
          <%= link_to 'もっと見る', about_path, class: 'waves-effect waves-orange orange lighten-2 btn' %>
        </div>
      </div>
    <% end %>
    <%= render 'ideas/index/latest_boad', title: '最新アイデア', ideas: @latest_ideas %>
    <div class="row">
      <div class="col s12 l8">
        <%= render 'ideas/index/ranking',
          icon_mark: '💬',
          board_title: '今月のコメントが多いアイデア',
          path: search_ideas_path(sort: :comments_num),
          ideas: @most_commented_ideas %>
        <%= render 'ideas/index/ranking',
          icon_mark: '💛',
          board_title: '今月のハートが多いアイデア',
          path: search_ideas_path,
          ideas: @liked_ideas %>
      </div>
      <div class="col s12 l4">
        <%= render 'ideas/index/featured_users',
          icon: '🚀',
          title: '今週の注目コメンテーター',
          path: search_users_path(sort: :weekly_comments),
          users: @weekly_commented_users %>
        <%= render 'ideas/index/featured_users',
          icon: '💡',
          title: '今月の注目アイデアマン',
          path: search_users_path(sort: :monthly_published),
          users: @monthly_published_users %>
      </div>
    </div>
    <div class="row">
      <div class="col s12 l8">
        <%= render 'ideas/index/ranking',
          icon_mark: tag.i('groups', class: 'material-icons'),
          board_title: '開発者募集中のアイデア',
          path: cooperations_path,
          ideas: @on_board_ideas %>
        <%= render 'ideas/index/ranking',
          icon_mark: tag.i('check_circle', class: 'material-icons'),
          board_title: '最近実現したアイデア',
          path: search_ideas_path(product_apply: :approved),
          ideas: @deployed_ideas %>
      </div>
    </div>
    <% unless current_user %>
      <div class="concept">
        <div class="concept_bg">
          <div class="concept_title">
            <p>CONCEPT</p>
          </div>
          <div class="concept_headline">
            <p>アイデアをデザインし、</p>
            <p>エンジニアの出会いを</p>
            <p>盛り上げる</p>
          </div>
          <div class="el_word">
            <p><span>i</span>dea</p>
            <p><span>d</span>esign</p>
            <p><span>e</span>ngineer</p>
            <p><span>e</span>ncounter</p>
            <p><span>e</span>ncourage</p>
          </div>
          <div class="main_copy">
            <p>
              「社会の役に立ちそう」「あると助かるな」を投稿<br>
              サービスの需要を視覚化、市場調査をした上で開発ができる<br>
              <br>
              あなたの「困ってる」を形に<br>
              コードで社会に貢献してみませんか？
            </p>
          </div>
        </div>
      <% end %>
    </div>
    <%= render 'common/service_fund' %>
  </div>
</div>
