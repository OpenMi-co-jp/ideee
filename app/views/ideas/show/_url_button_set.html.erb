<% if @idea["#{item}"].present? %>
  <button class="btn <%= "idea-button--#{item}" %> mh-3" onClick="window.open('<%= @idea["#{item}"] %>','_blank')">
  <% if item == 'product_url' %>
    <div class="material-icons <%= "idea-button--icon-#{item}" %>">phonelink</div>
  <% else %>
    <%= embedded_svg 'icons/mark-github.svg', class: "idea-button--icon-#{item}" %>
  <% end %>
    <span class="idea-button--label">
      <%= t("activerecord.attributes.idea.button.#{item}") %>
    </span>
  </button>
  <br>
<% end %>
