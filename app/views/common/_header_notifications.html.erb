<li class='nav-link'>
  <%= link_to '#', data: { target: "dropdown_bell" }, class:'dropdown-trigger white' do %>
    <% if !notifications.map{|n| n.checked}.all? %>
      <i class="material-icons p-notification__circle" style="font-size: 2px;">circle</i>
    <% end %>
    <p><%= embedded_svg 'icons/bell.svg', class: 'header__bell' %></p>
  <% end %>
</li>
<ul id='dropdown_bell' class='dropdown-content p-notification__ul'>
  <% if notifications&.any? %>
    <% notifications.each do |notification| %>
      <%= render 'notifications/notification', notification: notification %>
    <% end %>
    <div class="p-notification__index_path">
      <%= link_to ">> 通知一覧を見る", notifications_path, class: 'p-notification__index_path__link' %>
    </div>
  <% else %>
    <li class='p-notification__no_message'>通知はありません</li>
  <% end %>
</ul>
