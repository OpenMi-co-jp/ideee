<%= link_to user_path(team.owner), title: 'ユーザーリンク' do %>
  <%= user_icon(team.owner, size: 'small') %>
<% end %>
<% if !team&.members.blank? %>
  <div class='c-user-list'>
    <i class="material-icons p-2 mw-3">groups</i>
    <% team.members.each do |user| %>
      <%= link_to user_path(user), class:'c-user-list__icon', title: 'ユーザーリンク' do %>
        <%= user_icon(user, size: 'small') %>
      <% end %>
    <% end %>
  </div>
<% end %>
