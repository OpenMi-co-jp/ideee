<div class='cooperation'>
  <h4 class='orange-text center'>このアイデアの開発者を募集しますか？</h4>
  <div class='cooperation__idea_img mt-3 mb-5'>
    <%= image_set(@idea)  %>
  </div>
  <div class='idea__status cooperation__idea-status gray-3'>
    <p><%= "投稿日 #{@idea.created_time}" %></p>
    <div class='idea__comments'>
      <%= image_tag 'icons/comment.svg', class: 'icon-size gray-4', loading: "lazy" %>
      <p class='gray-5 ml-2'><%= @idea.comments_num %></p>
    </div>
    <div class='idea__eyes'>
      <%= image_tag 'icons/eye.svg', class: 'icon-size gray-4', loading: "lazy" %>
      <p class=' gray-5 ml-1'><%= @idea.view %></p>
    </div>
  </div>
  <div class='cooperation__idea-content'>
    <label>アイデア詳細</label>
    <%= @idea.note %>
  </div>
  <div class='cooperation__btns'>
    <%= link_to t('default.cancel'), idea_path(@idea), class: 'btn gray-3-back' %>
    <%= link_to t('default.team.start'), start_cooperations_path(idea_id: @idea), method: :post, class: 'btn orange-action-back'%>
  </div>
</div>
