<header>
  <ul>
    <li>
      <ul>
        <% if current_user %>
          <li class='text-monospace m-3'>
            <%# <%= "#{current_user.name}さん"%> %>
          </li>
        <% end %>
        <li class='btn btn-outline-warning'>
          <%= link_to 'タスク状況', ideas_path %>
        </li>
      </ul>
    <li class='btn btn-outline-warning btn-lg'>
      <%= link_to 'One Task', root_path %>
    </li>
    <li>
      <ul class='login_out_ul'>
        <li class='btn btn-outline-warning'>
          <%= link_to new_idea_path %>
          <i class='fa fa-plus-circle fa-2x'>
        </li>
        <% if current_user %>
          <li class='btn btn-outline-warning mx-2 nav-link'>
            <%= link_to 'ログアウト', logout_path %>
          </li>
        <% else %>
          <li class='btn btn-outline-warning mx-2 nav-item'>
            <%= link_to 'ログイン', login_path %>
          </li>
        <% end %>
      </ul>
    </li>
  </ul>
</header>
