<% if !users.blank? %>
  <a class='dropdown-trigger btn orange-soft-back' href='#' data-target='dropdown-team-member'>
    <i class="material-icons left">groups</i>メンバー：<%= users.length %>名
  </a>
  <ul id='dropdown-team-member' class='dropdown-content'>
    <% users.each do |user| %>
      <li>
        <%= link_to user_path(user.id), target: :_blank do %>
          <div class='c-team-member'>
            <div class="c-team-member__def">
              <%= user_definiton(user, ver='short') %>
            </div>
            <%= user_icon(user, size: 'small') %>
            <div class='c-team-member__name'><%= user.name %></div>
          </div>
        <% end %>
      </li>
      <li class="divider" tabindex="-1"></li>
    <% end %>
  </ul>
<% end %>
