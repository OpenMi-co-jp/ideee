<footer>
  <div class="container orange-action-back">
    <div class="footer-body mt-3 p-3">
      <ul class="footer-top row">
        <li class='col l3 s12'>
          <%= link_to root_path, class:'footer-logo' do %>
            <%= image_tag 'footer-logo.svg', class: "ml-3", alt: "ideee"%></li>
          <% end %>
        <li class='col l9 s12'>
          <ul class='row footer-list left'>
            <li class='col l2 m6 s12 offset-l5'><%= link_to 'アイデアマン', search_users_path(key: 'idea_man'), class: "white-text" %></li>
            <li class='col l2 m6 s12'><%= link_to 'エンジニア', search_users_path(key: 'engineer'), class: "white-text" %></li>
            <li class='col l3 m6 s12'><%= link_to 'ユーザーランキング', users_path, class: "white-text" %></li>
            <%# ディスカッションを追加 %>
            <%# <li><a class="white-text" href="#!">ディスカッション</a></li> %>
          </ul>
        </li>
      </ul>
      <ul class="mt-2 row">
        <li class='col l8 s12 mt-3'>
          <ul class='row footer-list right'>
            <li class='col l3 s12'><%= link_to 'アイディーについて', about_path, class: "white-text" %></li>
            <li class='col l2 s12'><%= link_to '利用規約', terms_of_service_path, class: "white-text" %></li>
            <li class='col l3 s12'><%= link_to 'プライバシーポリシー', privacy_policy_path, class: "white-text" %></li>
            <li class='col l2 s12'><%= link_to 'よくある質問', frequent_questions_path, class: "white-text" %></li>
            <li class='col l2 s12'><%= link_to '運営者', "https://naruhiro-portfolio.firebaseapp.com/", class: "white-text", target: :_blank %></li>
            <%# TODO:募金の説明を追加 %>
            <%# <li><a class="white-text" href="#!">募金について</a></li> %>
          </ul>
        </li>
        <li class='col l4 s12'>
          <ul class='flex right'>
            <li class="share-box mr-5">
              <%= link_to twitter_share('アイデアとエンジニアのマッチングサイトideee', root=true), target: '_blank' do %>
                <%= image_tag "twitter_icon.svg", class: "twitter-share", alt: "Twitter share"%>
              <% end %>
            </li>
            <li class="share-box mr-5">
              <%= link_to facebook_share(root=true), target: '_blank' do %>
                <%= image_tag "facebook_icon.png", class: "twitter-share", alt: "Facebook share"%>
              <% end %>
            </li>
            <li class="share-box mr-5">
              <%= link_to line_share('アイデアとエンジニアのマッチングサイトideee', root=true), target: '_blank' do %>
                <%= image_tag "line_icon.png", class: "twitter-share", alt: "LINE share"%>
              <% end %>
            </li>
            <li class="share-box mr-5">
              <%= link_to hatebu_share(root=true), target: '_blank' do %>
                <%= image_tag "hatebu_icon.png", class: "twitter-share", alt: "LINE share"%>
              <% end %>
            </li>
          </ul>
        </li>
      </ul>
    </div>
  </div>
  <div class="copyright gray-5">
    ©️ <%= Time.current.year %> ﾌﾟﾛﾀﾞｸﾄｴﾝｼﾞﾆｱ
  </div>
</footer>
