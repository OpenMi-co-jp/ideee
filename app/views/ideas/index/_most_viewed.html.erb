    <p class='icon-mark grid-middle'>👀</p>
    <h4 class='social-good-title orange-action'>View数の多いアイデア</h4>
    <%= link_to search_ideas_path(sort: :view), class: 'more-info mt-3 flex gray-5' do %>
      <i class="material-icons">chevron_right</i>もっと見る
    <% end %>
  </div>
  <%= render 'common/column_board', ideas: @most_viewed_ideas %>
</div>
