<%= form_with(model: idea, multipart: true, id: 'idea_form', local: false) do |form| %>
  <% if idea.errors.any? %>
    <div id="error_explanation">
      <ul>
        <% idea.errors.each do |error| %>
          <h4>
            <li><%= error.full_message %></li>
          </h4>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class='row'>
    <div class='idea-column-img col s12 l3'>
      <div class="field">
        <%= form.label :icon %>
        <%= image_tag '', id: "avatar_img_prev", class:"disabled", loading: "lazy" %>
        <div class='present-img'>
          <% if idea.icon.file.present? %>
            <%= image_tag(idea.icon.to_s, loading: "lazy") %>
          <% end %>
        </div>
        <%= form.file_field :icon, accept: 'image/png,image/jpeg', id: "post-img", class: 'mh-3' %>
      </div>
    </div>
    <div class='idea-status-column col s12 l9'>
      <div class="field input-field">
        <%= form.text_field :name, placeholder: 'アイデア名', data: { length: 50 }, class: 'validate', required:'required' %>
        <%= form.label :name, class: 'required active' %>
        <span class="helper-text" data-error="アイデア名を入力してください。"></span>
      </div>
      <div class="field">
        <%= form.label :tags_up_to_three %><a class="help-tip tags">?</a>
        <div class="chips"></div>
        <%= form.hidden_field :tag_list, id: 'tag-hidden-field' %>
      </div>
      <div class="field input-field">
        <%= form.text_area :background, placeholder: '背景やストーリー', class: 'materialize-textarea validate', required:'required' %>
        <%= form.label :background, class: 'required active' %>
        <span class="helper-text" data-error="背景を入力してください。"></span>
      </div>
      <div class="field input-field">
        <%= form.text_area :goal, placeholder: 'どうなって欲しいか', class: 'materialize-textarea validate', required:'required' %>
        <%= form.label :goal, class: 'required active' %>
        <span class="helper-text" data-error="ゴールを入力してください。"></span>
      </div>
      <ul class="collapsible">
        <li>
          <div class="collapsible-header"><i class="material-icons">expand_more</i>さらにブラッシュアップ</div>
          <div class="collapsible-body">
            <div class="field input-field">
              <%= form.text_area :issue, placeholder: '課題・困っていること', class: 'materialize-textarea' %>
              <%= form.label :issue, class: 'active' %>
            </div>
            <div class="field input-field">
              <%= form.text_area :wish_function, placeholder: '欲しい機能', class: 'materialize-textarea' %>
              <%= form.label :wish_function, class: 'active' %>
            </div>
            <div class="field input-field">
              <%= form.text_area :hypothesis, placeholder: '検証のための仮説', class: 'materialize-textarea' %>
              <%= form.label :hypothesis, class: 'active' %>
            </div>
            <div class="field input-field">
              <%= form.text_area :target, placeholder: 'サービスを利用する典型的なユーザー像', class: 'materialize-textarea' %>
              <%= form.label :target, class: 'active' %>
            </div>
            <div class="field input-field">
              <%= form.text_area :similar, placeholder: '類似サービス・競合', class: 'materialize-textarea' %>
              <%= form.label :similar, class: 'active' %>
            </div>
          </div>
        </li>
      </ul>
      <div class="field">
        <%= form.label :note %>
        <%= form.rich_text_area :note, placeholder: '補足' %>
      </div>
      <% if idea.cooperation_not_started? || idea.id.nil? || idea.draft %>
        <div class="field switch c-team-switch">
          <%= form.label :cooperation %><a class="help-tip cooperation-guide">?</a>
          <%= form.hidden_field :cooperation_switch, value: params[:cooperation_switch] %>
          <div class="switch c-team-switch__btn">
            <label class="c-team-switch__label">
              募集しない
              <input type="checkbox" id='cooperation_switch' <%= 'checked' if idea.cooperation_ongoing? %>>
              <span class="lever"></span>
              募集する
            </label>
          </div>
        </div>
      <% end %>
      <div class="field">
        <%= form.label :product_url %><a class="help-tip product-url">?</a>
        <%= form.text_field :product_url, placeholder: 'プロダクトのURL' %>
      </div>
      <% if idea.draft || idea.id.nil? %>
        <%= form.submit t('default.save_draft'), class: 'btn orange-soft-back mh-3 idea-btn' %>
      <% end %>
      <% if idea.draft %>
        <%= form.submit t('default.publish'), class: 'btn orange-action-back mh-3 idea-btn' %>
      <% else %>
        <%= form.submit class: 'btn orange-action-back mh-3 idea-btn' %>
      <% end %>
    </div>
  </div>
<% end %>
