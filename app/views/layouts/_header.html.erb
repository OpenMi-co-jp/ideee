<header class='position-sticky'>
  <ul class='header-body'>
    <li class='text-monospace m-3'>
      <%= link_to root_path  do %>
        <%= image_tag 'ideee-tech-logo.png', class: "footer-logo"%>
      <% end %>
    </li>
    <li class='serch_column flex'>
      <p class='grid-middle gray-3'>
        <i class="material-icons">search</i>
      </p>
      <%= form_tag(search_ideas_path,:method => 'get') do %>
        <%= text_field_tag :keyword, '', class: 'search_box', size:'25', placeholder: 'アイデアを検索' %>
      <% end %>
    </li>
    <li class=''>
      <%= link_to '#', data: { target: "dropdown_rank" }, class:'dropdown-trigger white' do %>
        <p><%= image_tag 'icons/rank.svg'%></p>
      <% end %>
      <ul id='dropdown_rank' class='dropdown-content'>
        <li>
          <%= link_to users_path do %>
            ユーザーランキング
          <% end %>
        </li>
        <li class="divider" tabindex="-1"></li>
        <li>
          <%= link_to search_users_path(key: 'idea_man') do %>
            <i class="material-icons">lightbulb_outline</i>アイデアマン
          <% end %>
        </li>
        <li>
          <%= link_to search_users_path(key: 'engineer') do %>
            <i class="material-icons">computer</i>エンジニア
          <% end %>
        </li>
      </ul>
      <%# TODO: ディスカッション機能の追加 %>
      <%# <li class=''>
        <%= link_to 'ディスカッション', root_path %>
      <%# </li> %>
    </li>
    <% if current_user %>
      <li class='nav-link'>
        <%= link_to 'アイデア投稿', new_idea_path, class: 'waves-effect btn orange-action-back' %>
      </li>
      <li>
        <%= link_to '#', data: { target: "dropdown_user" }, class:'dropdown-trigger btn-floating btn-large white' do %>
          <% user_icon(current_user) %>
        <% end %>
      </li>
      <ul id='dropdown_user' class='dropdown-content'>
        <li>
          <%= link_to user_path(id: current_user.id) do %>
            <i class="material-icons">account_circle</i>マイページ
          <% end %>
        </li>
        <li class="divider" tabindex="-1"></li>
        <li>
          <%= link_to edit_user_registration_path(id: current_user.id)  do %>
            <i class="material-icons">edit</i>ユーザー情報編集
          <% end %>
        </li>
        <li>
          <%= link_to destroy_user_session_path, method: :delete do %>
            <i class="material-icons">directions_walk</i>ログアウト
          <% end %>
        </li>
      </ul>
    <% else %>
      <li class='nav-item'>
        <%= link_to 'ログイン', new_user_session_path, class: 'waves-effect waves-orange btn white orange-action' %>
      </li>
      <li class='nav-item'>
        <%= link_to '登録する', new_user_registration_path, class: 'waves-effect btn orange-action-back' %>
      </li>
    <% end %>
  </ul>
</header>
