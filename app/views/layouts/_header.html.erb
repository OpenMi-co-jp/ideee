<header class='position-sticky'>
  <ul class='header-body'>
    <li class='text-monospace m-3'>
      <%= link_to root_path  do %>
        <%= image_tag 'ideee-tech-logo.png', class: "footer-logo"%>
      <% end %>
    </li>
    <% if current_user %>
      <li class='text-monospace m-3'>
        <%# <%= "#{current_user.name}さん"%>
      </li>
    <% end %>
    <li class='serch_column'>
      <%= form_tag(ideas_path,:method => 'get') do %>
        <%= text_field_tag :search, '', class: 'search_box', size:'30', placeholder: 'キーワードを入力してください' %>
      <% end %>
    </li>
    <li class=''>
      <li class=''>
        <%= link_to 'アイデアマン', users_path %>
      </li>
      <li class=''>
        <%= link_to 'エンジニア', users_path %>
      </li>
      <li class=''>
        <%= link_to 'ランキング', root_path %>
      </li>
      <%# TODO: ディスカッション機能の追加 %>
      <%# <li class=''>
        <%= link_to 'ディスカッション', root_path %>
      <%# </li> %>
    </li>
    <% if current_user %>
      <li class='waves-effect waves-orange btn orange-action-back mx-2 nav-link'>
        <%= link_to 'アイデア投稿', new_idea_path %>
      </li>
      <li>
        <%= link_to '#', data: { target: "dropdown_user" }, class:'dropdown-trigger btn-floating btn-large white' do %>
          <% user_icon(current_user) %>
        <% end %>
      </li>
      <ul id='dropdown_user' class='dropdown-content'>
        <li>
          <%= link_to user_path(id: current_user.id) do %>
            <i class="material-icons">account_circle</i>マイページ
          <% end %>
        </li>
        <li class="divider" tabindex="-1"></li>
        <li>
          <%= link_to edit_user_registration_path(id: current_user.id)  do %>
            <i class="material-icons">edit</i>ユーザー情報編集
          <% end %>
        </li>
        <li>
          <%= link_to destroy_user_session_path, method: :delete do %>
            <i class="material-icons">directions_walk</i>ログアウト
          <% end %>
        </li>
      </ul>
    <% else %>
      <li class='waves-effect waves-orange btn white mx-2 nav-item'>
        <%= link_to 'ログイン', new_user_session_path, class: 'orange-action' %>
      </li>
      <li class='waves-effect waves-orange btn orange-action-back mx-2 nav-item'>
        <%= link_to '登録する', new_user_registration_path %>
      </li>
    <% end %>
  </ul>
</header>
