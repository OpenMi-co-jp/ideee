<%# mete_tags %>
<% set_meta_tags title: "#{@user.name}のページ",
  og: {
    title: "#{@user.name}のページ",
    description: strip_tags(@user.description)&.gsub(/[\n]/, "")&.strip&.truncate(120)
  }
%>

<div class='p-user-show'>
  <div class="row">
    <div class="col s12 l3">
      <div class="c-user-icon-info">
        <div class='c-user-icon-info__icon'><%= user_icon(@user, size: 'large') %></div>
        <h1 class='c-user-icon-info__name'><%= @user&.name %></h1>
        <h5><%= @user&.point %></h5>
        <p class='c-user-icon-info__contributions'>Contributions</p>
        <p class='c-user-icon-info__created-date'><%= "作成日：#{l @user.created_at}" %></p>
      </div>
      <%= render 'common/user_url_list', user: @user %>
    </div>
    <div class="col s12 l9">
      <div class="row">
        <div class="col s10">
          <%= user_definiton(@user) %>
        </div>
      </div>
      <% if @user.description.present? %>
        <h2 class="c-user-content">
          <%= simple_format(text_url_to_link(@user.description), {}, sanitize: false) %>
        </h2>
      <% end %>
      <% if own_user_checked(@user) %>
        <%= link_to '編集', edit_user_registration_path(@user.id), class: 'mw-3' %>
      <% end %>
    </div>
  </div>
  <nav class="nav-extended c-nav-var">
    <div class="nav-content c-nav-var__content">
      <ul class="tabs tabs-transparent">
        <li class="tab c-nav-var__tab"><a class="active" href="#tab1" id="link1" title="アイデアリスト">アイデアリスト（<%= @user_published_ideas.size %>）</a></li>
        <li class="tab c-nav-var__tab"><a href="#tab2" id="link2" title="ハート">ハート（<%= @liked_idea_ids.size %>）</a></li>
        <li class="tab c-nav-var__tab"><a href="#tab3" id="link3" title="コメント">コメント（<%= @commented_idea_list.size %>）</a></li>
        <li class="tab c-nav-var__tab"><a href="#tab4" id="link4" title="チーム開発参加">チーム開発参加（<%= @joined_team_num %>）</a></li>
      </ul>
    </div>
  </nav>
  <div id="tab1" class="col s12">
    <div class="row">
      <div class="col s12 <%= own_user_checked(@user) ? 'l8' : 'l12' %>">
        <% if @published_ideas.present? %>
          <%= render 'common/column_board', ideas: @published_ideas, user_icon_view: 'off' %>
          <%= paginate @published_ideas, param_name: :published_page %>
        <% else %>
          <h5 class='no_idea_posted'>まだアイデアが投稿されていません</h5>
        <% end %>
      </div>
      <% if own_user_checked(@user) %>
        <div class="col s12 l4">
          <% if @user.ideas.drafts.present? %>
            <h4>下書きアイデア</h4>
            <%= render 'common/simple_board', ideas: @user.ideas.drafts %>
          <% else %>
            <h5 class='no_draft_posted'>まだ下書きがありません</h5>
            <p class='gray-3'>※下書きはあなたにしか見えません</p>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
  <div id="tab2" class="col s12">
    <% if @user.likes.present? %>
      <%= render 'common/column_board', ideas: @like_ideas %>
      <%= paginate @like_ideas, param_name: :like_page %>
    <% else %>
      <h5>まだアイデアにハートを送っていません</h5>
    <% end %>
  </div>
  <div id="tab3" class="col s12">
    <% if @user.comments.present? %>
      <%= render 'common/column_board', ideas: @commented_ideas %>
      <%= paginate @commented_ideas, param_name: :comment_page %>
    <% else %>
      <h5>まだアイデアにコメントをしていません</h5>
    <% end %>
  </div>
  <div id="tab4" class="col s12">
    <% if @joined_team_num.positive? %>
      <%= render_async joined_team_idea_path(user_id: @user.id) %>
    <% else %>
      <h5>まだチーム開発に参加をしていません</h5>
    <% end %>
  </div>
  <%= render 'common/fund_link', object: @user %>
  <%= render 'users/show/lead_to_post' if own_user_checked(@user) %>
</div>
