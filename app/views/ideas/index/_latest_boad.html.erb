<div class='boad'>
  <div class='back-color-board'></div>
  <div class='main-board'>
    <div class='flex'>
      <p class='icon-mark'>🎉</p>
      <b class='latest-title'>最近実現したアイデア</b>
    </div>
    <div class='latest-idea-colum'>
      <% if @latest_ideas%>
        <% @latest_ideas.each do |idea| %>
          <div class='idea-column-board'>
            <%= link_to idea_path(idea.id) do %>
              <div class='idea-column-img yellow-soft-back'>
                <%= image_set(idea) %>
                <div class= 'time-label'>
                  <%= idea.created_time %>
                </div>
              </div>
            <% end %>
            <p class='orange-action'><%= idea.name %></p>
            <p class='gray-2'><%= user_definiton(idea.user) %><%= idea.user.name %></p>
          </div>
        <% end %>
      <% end %>
    </div>
  </div>
</div>
