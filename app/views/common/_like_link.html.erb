<div class='like-click <%= 'clicked' if current_user&.like?(object) %>', data-id='<%= object.id %>'>
  <div class='likes-column'>
    <div class='like-image'>
      <%= embedded_svg "like-heart.svg" %>
    </div>
    <div class='likes-count'>
      <%= object.likes.length %>
    </div>
  </div>
</div>
