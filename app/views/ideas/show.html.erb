<%# mete_tags %>
<% set_meta_tags title: @idea.name,
  keywords: @idea.idea_tags.pluck(:name).join(','),
  og: {
    title: @idea.name,
    image: return_ogp_url(@idea.name),
    description: strip_tags(@idea.goal).gsub(/[\n]/, "").strip.truncate(120)
  }
%>

<div class='idea-show'>
  <div class='row'>
    <div class='idea-column-img col l3 s12'>
      <% if @idea.draft %>
        <div class='chip'><%= t('default.draft') %></div>
      <% end %>
      <div class='idea-date gray-3'>
        <%= embedded_svg 'icons/clock.svg', class: 'idea-date--clock'%>
        <%= idea_opened_date(@idea) %>
      </div>
      <%= image_set(@idea) %>
      <% unless @idea.draft %>
        <div class='hide-on-small-only'>
          <%= render 'ideas/show/pc_idea_share' %>
        </div>
        <div class='hide-on-med-and-up'>
          <%= render 'ideas/show/mobile_idea_share' %>
        </div>
      <% end %>
      <%= render 'teams/box_on_idea', idea: @idea %>
    </div>
    <div class='idea-status-column col l9 s12'>
      <h1 class='idea-name orange-action'>
        <%= @idea.name %>
      </h1>
      <div class='hide-on-small-only'>
        <%= render 'ideas/show/pc_idea_status', idea: @idea, time_on_page: @time_on_page %>
      </div>
      <div class='hide-on-med-and-up'>
        <%= render 'ideas/show/mobile_idea_status', idea: @idea, time_on_page: @time_on_page %>
      </div>
      <div class='idea-content mb-2'>
        <% if current_user || @idea.approved? %>
          <%= render 'ideas/show/title_set', item: 'background' %>
          <%= render 'ideas/show/title_set', item: 'goal' %>
          <%= render 'ideas/show/title_set', item: 'issue' %>
          <%= render 'ideas/show/title_set', item: 'wish_function' %>
          <%= render 'ideas/show/title_set', item: 'hypothesis' %>
          <%= render 'ideas/show/title_set', item: 'target' %>
          <%= render 'ideas/show/title_set', item: 'similar' %>
          <%= render 'ideas/show/title_set', item: 'note' %>
          <%= render 'ideas/show/title_set', item: 'github_url' %>
        <% else %>
          <% if @idea&.background.length > 0 %>
            <%= strip_tags(@idea&.background).gsub(/[\n]/, "").strip.truncate(60) %>
          <% else %>
            <%= strip_tags(@idea&.note.to_s).gsub(/[\n]/, "").strip.truncate(120) %>
          <% end %>
          <div class='white p-3'>
            <div class='flex login-guidance'>
              <div class='nav-item'>
                <%= link_to 'ユーザー登録', new_user_registration_path, class: 'waves-effect btn orange-action-back' %>
              </div>
              <div class='flex'>
                <p class='grid-middle'>or</p>
                <%= link_to 'ログイン', new_user_session_path, class: 'grid-middle' %>
                <p class='grid-middle p-0'>して確認</p>
              </div>
              <p>
            </div>
          </div>
        <% end %>
        <% if @idea.approved? %>
          <%= render 'ideas/show/title_set', item: 'product_url' %>
        <% end %>
      </div>
      <% if current_user&.own?(@idea) %>
        <% if @idea.draft %>
          <%= link_to t('default.publish'), publish_idea_path(@idea), method: :post, data: { confirm: '公開してもよろしいですか？' }, class: 'btn orange-action-back'%>
        <% end %>
        <%= link_to '編集', edit_idea_path(@idea), class: 'mw-3' %>
        <%= link_to '削除', idea_path(@idea), method: :delete, data: { confirm: '削除してもよろしいですか？' }, class: 'mw-3' %>
      <% end %>
    </div>
  </div>

  <hr>

  <% unless @idea.draft %>
    <%= render 'comments/board', object: @idea %>
    <%= render 'comments/form' %>
    <%= render_async suggest_ideas_path(id: @idea.id), html_options: { 'data-turbolinks-track': 'reload' } %>
    <%= render 'common/fund_link', object: @idea %>
  <% end %>

  <%= render 'ideas/show/vote_modal' %>
</div>
