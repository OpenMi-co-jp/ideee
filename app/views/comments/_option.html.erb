<div class='c-unit-comment__options'>
  <div class='c-comment-icons'>
    <%= link_to '#', data: { target: "dropdown_comment-more_vert-#{comment.id}" }, class:'dropdown-trigger' do %>
      <i class="material-icons">more_vert</i>
    <% end %>
    <ul id="dropdown_comment-more_vert-<%= comment.id %>" class='dropdown-content'>
      <li>
        <%= link_to edit_comment_path(comment) do %>
          編集
        <% end %>
      </li>
      <li>
        <%= link_to '#', id: comment.id, class: 'dropdown-comment-delete', remote: true do %>
          削除
        <% end %>
      </li>
    </ul>
  </div>
</div>
