<div class="sign-form">
  <h2><%= t '.title' %></h2>

  <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>

    <div class="field">
      <%= f.label :email %><br />
      <%= f.email_field :email, autofocus: true, autocomplete: "email", class: 'validate', required:'required' %>
      <span class="helper-text" data-error="正しい形式のメールアドレスを入力してください。"></span>
    </div>

    <%= f.submit class: 'btn orange-action-back mh-1' %>
  <% end %>

  <%= render "devise/shared/links" %>
</div>
