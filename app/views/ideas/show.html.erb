<%# OGP %>
<%= content_for(:title, @idea.name) %>
<%= content_for(:description, @views) %>
<%= content_for(:image_url, full_url(@idea.icon.to_s)) %>
<p>
  <strong>Name:</strong>
  <%= @idea.name %>
</p>

<p>
  <strong>Icon:</strong>
  <%= image_tag "#{@idea.icon.to_s}" if @idea&.icon %>
</p>

<p>
  <strong>Note:</strong>
  <%= @idea.note %>
</p>

<p>
  <strong>Views:</strong>
  <%= @views %>
</p>

<% if current_user.id == @idea.user_id %>
  <p>
    <strong>平均ページ滞在時間:</strong>
    <%= Time.at(@time_on_page.to_i).utc.strftime('%X') %>
  </p>
<% end %>

<%= link_to 'Edit', edit_idea_path(@idea) %> |
<%= link_to 'Back', ideas_path %>
