<% if idea.cooperation_ongoing? %>
  <% if current_user&.cooperation_joined?(idea) %>
    <%= link_to t('default.cooperation_cancel'), cooperation_path(idea_id: idea), method: :delete, data: { confirm: 'このアイデアの開発を辞退しますか' }, class: 'waves-effect waves-light btn-large orange darken-4'%>
  <% else %>
    <%= link_to t('default.cooperation_join'), cooperations_path(idea_id: idea), method: :post, data: { confirm: 'このアイデアの開発に参加しますか？' }, class: 'waves-effect waves-light btn-large orange darken-4'%>
  <% end %>
<% end %>
