<% if @idea["#{item}"].present? %>
  <button class="btn <%= "idea-button--#{item}" %> mh-3" onClick="window.open('<%= @idea["#{item}"] %>','_blank')">
  <% unless t("activerecord.attributes.idea.button_icon.#{item}").blank? %>
    <div class="material-icons <%= "idea-button--icon-#{item}" %>"><%= t("activerecord.attributes.idea.button_icon.#{item}") %></div>
  <% else %>
    <%= embedded_svg t("activerecord.attributes.idea.button_icon_file.#{item}"), class: "idea-button--icon-#{item}" %>
  <% end %>
    <span class="idea-button--label">
      <%= t("activerecord.attributes.idea.button.#{item}") %>
    </span>
  </button>
<% end %>
