<div id="modal_difficulty" class="modal">
  <div class="modal-content">
    <h4>アイデア実現の難しさをVote</h4>
    <p>実現するための難易度を3段階で評価</p>
      <div class='modal_links'>
        <% @levels.each_with_index do |(key, value), index| %>
          <%= link_to "#{key.capitalize}",
            difficultys_path(level: key, idea_id: @idea.id),
            method: :post,
            class:"waves-effect waves-light orange darken-#{index * 2} btn-large modal-close-trigger",
            remote: true %>
        <% end %>
      </div>
  </div>
</div>
