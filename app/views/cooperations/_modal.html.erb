<div id="modal_cooperation" class="modal">
  <div class="modal-content">
    <h4><%= t("default.cooperation.titles.#{action}") %></h4>
    <div>開発者一覧(<%=  @idea.cooperation_users.length %>名)</div>
    <ul class="collection m-5 row">
      <% @idea.cooperation_users.each do |user| %>
        <li class="collection-item col s12 m6 l3 p-2">
          <div class='flex'>
            <%= user_icon(user, size: 'small') %>
            <div>
              <div class='pr-3'><%= user.name %><%= user_definiton(user, ver='short') %></div>
            </div>
          </div>
        </li>
      <% end %>
    </ul>
    <p class='gray-5'><%= t("default.cooperation.messages.#{action}") %></p>
    <div class='cooperation-submit-btn'>
      <%= link_to t('default.cancel'), '#cancel', class: 'btn gray-3-back cooperation-modal-close-btn' %>
      <%= link_to t("default.cooperation.#{action}"), path, method: method, class: "btn orange-action-back" %>
    </div>
  </div>
</div>
