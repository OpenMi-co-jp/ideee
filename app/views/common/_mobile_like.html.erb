<% if current_user && !current_user.own?(object) %>
  <%= render 'common/mobile_like_link', object: object %>
<% else %>
  <%= link_to '#modal_before_login', data: { turbolinks: false }, class: "modal-trigger-login #{own_object?(object)}" do %>
    <div class='mobile-like'>
      <span class='like-image'>
        <%= embedded_svg "like-heart.svg", alt: 'いいね数' %>
      </span>
      <span class='likes-count'>
        <%= object.likes.length %>
      </span>
    </div>
  <% end %>
<% end %>