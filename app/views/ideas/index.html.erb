<div class='idea-index'>
  <div class='board'>
    <div class='full-pic'>
      <%= link_to(
        'ideeeとは',
        '#modal_intro',
        data: { turbolinks: false },
        class: 'waves-effect waves-white orange lighten-2 btn modal-trigger turorial-button',
        id: 'modal-trigger-intro'
      )%>
      <% unless current_user %>
        <%= link_to '新規登録', new_user_session_path, class: 'waves-effect waves-orange btn orange darken-1 new-user-button' %>
      <% end %>
    </div>
    <div id="modal_intro" class="modal">
      <div class="modal-content">
        <h4>アイディアとエンジニアのマッチングサイト</h4>
        <p><b>アイディアマン：</b>身の回りで困ってることや「あったらいいな」をエンジニアに投げかけることができる</p>
        <p><b>エンジニア：</b>需要のあるアイディアが手に入り、人助けができる</p>
      </div>
      <div class="modal-footer">
        <%= link_to 'もっと見る', "https://naruhero.netlify.app/blog/3", class: 'waves-effect waves-orange orange lighten-2 btn', target: :_blank %>
      </div>
    </div>
    <%= render 'ideas/index/latest_boad' %>
    <div class="row">
      <div class="col s8">
        <%= render 'ideas/index/social_good' %>
      </div>
      <div class="col s4">
        <%= render 'ideas/index/featured_user' %>
      </div>
    </div>
  </div>
</div>
