<div class='boad'>
  <div class='back-color-board'></div>
  <div class='main-board'>
    <div class='flex'>
      <p class='icon-mark white-back'>🎉</p>
      <b class='board-title white-text'>最新アイデア</b>
    </div>
    <div class='carousel'>
      <% if @latest_ideas%>
        <% @latest_ideas.each do |idea| %>
          <div class='carousel-item'>
            <%= link_to idea_path(idea.id) do %>
              <div class='idea-column-img yellow-soft-back'>
                <%= image_set(idea) %>
                <div class='time-label'>
                  <%= idea.created_time %>
                </div>
              </div>
            <% end %>
            <p class='orange-action'><%= idea.name %></p>
            <p class='gray-3'><%= user_definiton(idea.user, ver='short') %><%= idea.user.name %></p>
          </div>
        <% end %>
      <% end %>
    </div>
  </div>
</div>
