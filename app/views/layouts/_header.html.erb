<header class='position-sticky'>
  <ul>
    <li class='text-monospace m-3'>
      <%= image_tag 'ideee-tech-logo.png', class: "footer-logo"%>
    </li>
    <% if current_user %>
      <li class='text-monospace m-3'>
        <%# <%= "#{current_user.name}さん"%>
      </li>
    <% end %>
  <li class='serch_column'>
    <%= form_tag(ideas_path,:method => 'get') do %>
      <%= text_field_tag :search, '', class: 'search_box', placeholder: 'キーワードを入力してください' %>
    <% end %>
  </li>
  <li class=''>
    <li class=''>
      <%= link_to 'アイデアマン', root_path %>
    </li>
    <li class=''>
      <%= link_to '製作者', root_path %>
    </li>
    <li class=''>
      <%= link_to 'ランキング', root_path %>
    </li>
    <li class=''>
      <%= link_to 'ディスカッション', root_path %>
    </li>
  </li>
  <li>
    <% if current_user %>
      <li class='btn btn-outline-warning mx-2 nav-link'>
        <%= link_to 'ログアウト', destroy_user_session_path %>
      </li>
    <% else %>
      <li class='btn btn-outline-warning mx-2 nav-item'>
        <%= link_to 'ログイン', new_user_session_path %>
      </li>
      <li class='btn btn-warning mx-2 nav-item'>
        <%= link_to '新規登録', new_user_session_path %>
      </li>
    <% end %>
  </ul>
</header>
