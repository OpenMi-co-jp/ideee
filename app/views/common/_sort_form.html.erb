<%= form_with url: search_ideas_path, method: :get, id: 'sort_form' do |f| %>
  <%= f.select :selected_sort, options_for_select({いいねが多い順: :likes_num, コメント数が多い順: :comments_num, View数が多い順: :view, 名前の昇順: :asc, 名前の降順: :desc, 作成日が新しい順: :newly_created, 作成日が古い順: :old_created }, selected: @sort  ) %>
  <%= f.hidden_field :keyword, value: @keyword %>
<% end %>
