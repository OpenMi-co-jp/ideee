<div class='idea-index'>
  <div class='board'>
    <div class='full-pic'>
      <a class="waves-effect waves-white orange lighten-2 btn modal-trigger turorial-button" href="#modal_intro">ideeeとは</a>
      <% unless current_user %>
        <%= link_to '新規登録', new_user_session_path, class: 'waves-effect waves-orange btn orange darken-1 new-user-button' %>
      <% end %>
    </div>
    <div id="modal_intro" class="modal">
      <div class="modal-content">
        <h4>アイディアとエンジニアのマッチングサイト</h4>
        <p><b>アイディアマン：</b>身の回りで困ってることや「あったらいいな」をエンジニアに投げかけることができる</p>
        <p><b>エンジニア：</b>需要のあるアイディアが手に入り、人助けができる</p>
      </div>
      <div class="modal-footer">
        <%= link_to 'もっと見る', "https://naruhero.netlify.app/blog/3", class: 'waves-effect waves-orange orange lighten-2 btn', target: :_blank %>
      </div>
    </div>
    <%= render 'ideas/index/latest_boad' %>
    <table>
      <thead>
        <tr class='mb-3'>
          <th>Name</th>
          <th>Icon</th>
          <th>Note</th>
          <th>View</th>
          <th colspan="3"></th>
        </tr>
      </thead>
      <tbody>
        <% @ideas.each do |idea| %>
          <tr>
            <td><%= idea.name %></td>
            <%= image_tag "#{@idea&.icon.to_s}" if @idea&.icon %>
            <td><%= idea.note %></td>
            <td><%= idea.view %></td>
            <td><%= idea.user_id %></td>
            <td><%= link_to 'Show', idea %></td>
            <td><%= link_to 'Edit', edit_idea_path(idea) %></td>
            <td><%= link_to 'Destroy', idea_path(idea), method: :delete, data: { confirm: 'Are you sure?' } %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
