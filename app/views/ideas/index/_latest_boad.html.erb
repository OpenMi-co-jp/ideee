<div class='boad'>
  <div class='back-color-board'></div>
  <div class='main-board'>
    <div class='flex'>
      <p class='icon-mark'>🎉</p>
      <b class='latest-title'>最近実現したアイデア</b>
    </div>
    <div class='latest-idea-colum'>
      <% if @latest_ideas%>
        <% @latest_ideas.each do |idea| %>
          <a href="<%= idea_path(idea.id) %>" %>
            <div class='idea-picture-column z-depth-1 brown lighten-5'>
              <div class= 'idea-img'>
                <%= image_set(idea) %>
              </div>
              <div class= 'time-label'>
                <%= idea.created_time %>
              </div>
              <div class= 'row'>
                <%= idea.name %>
                <%= idea.user.name %>
                <%= idea.view %>
              </div>
            </div>
          </a>
        <% end %>
      <% end %>
    </div>
  </div>
</div>
