<div class='idea-index'>
  <div class='board'>
    <div class='full-pic'>
      <%= link_to '新規登録', new_user_session_path, class: 'waves-effect waves-orange btn orange darken-1 new_user_button' %>
      <%= link_to 'ideeeとは', new_user_session_path, class: 'waves-effect waves-orange btn grey darken-1 turorial_button' %>
    </div>
    <%= render 'ideas/index/latest_boad' %>
    <table>
      <thead>
        <tr class='mb-3'>
          <th>Name</th>
          <th>Icon</th>
          <th>Note</th>
          <th>View</th>
          <th colspan="3"></th>
        </tr>
      </thead>
      <tbody>
        <% @ideas.each do |idea| %>
          <tr>
            <td><%= idea.name %></td>
            <%= image_tag "#{@idea&.icon.to_s}" if @idea&.icon %>
            <td><%= idea.note %></td>
            <td><%= idea.view %></td>
            <td><%= idea.user_id %></td>
            <td><%= link_to 'Show', idea %></td>
            <td><%= link_to 'Edit', edit_idea_path(idea) %></td>
            <td><%= link_to 'Destroy', idea_path(idea), method: :delete, data: { confirm: 'Are you sure?' } %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
