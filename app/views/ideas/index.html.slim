p#notice
  = notice
h1
  | Ideas
table
  thead
    tr
      th
        | Name
      th
        | Icon
      th
        | Note
      th
        | View
      th[colspan="3"]
  tbody
    - @ideas.each do |idea|
      tr
        td
          = idea.name
        td
          = idea.icon
        td
          = idea.note
        td
          = idea.view
        td
          = link_to 'Show', idea
        td
          = link_to 'Edit', edit_idea_path(idea)
        td
          = link_to 'Destroy', idea, method: :delete, data: { confirm: 'Are you sure?' }
br
= link_to 'New Idea', new_idea_path
