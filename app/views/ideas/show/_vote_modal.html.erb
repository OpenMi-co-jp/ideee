<div id="modal_difficulty" class="modal" data-id="<%= @idea.id %>" data-modal="<%= current_user&.voted?(object) ? false : true %>">
  <div class="modal-content">
    <div class="center">
      <%= render 'difficultys/vote_modal_titles', object: object %>
    </div>
    <div class='modal_links row'>
      <% Difficulty.levels.each do |(key, value)| %>
        <div class='col s12 m4 l4 mb-3'>
          <div class="c-vote-button <%= key %> modal-link-btn">
            <% if current_user&.voted?(object) %>
              <%# すでに投票していたらそのタグの種類を検索する %>
              <%= link_to search_ideas_path(difficulty: value) do %>
                <p><%= key.capitalize %></p>
                <b class="c-vote-button__rate"><%= object.voted_percentage(key) %></b>
              <% end %>
            <% else %>
              <%= link_to key.capitalize,
                difficultys_path(level: key, idea_id: @idea.id),
                method: :post,
                class:"modal-close-trigger",
                remote: true %>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>
