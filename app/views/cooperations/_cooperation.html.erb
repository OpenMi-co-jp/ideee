<div class='p-2 center'>
  <%= render 'cooperations/cooperation_state', idea: idea %>
  <% if current_user&.own?(idea) %>
    <%= render 'cooperations/owner_link', idea: idea %>
  <% else %>
    <%= render 'cooperations/cooperator_link', idea: idea %>
  <% end %>
  <%= render 'cooperations/cooperation_users', users: idea.cooperation_users %>
</div>
