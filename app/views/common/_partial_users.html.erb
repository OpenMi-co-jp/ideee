<div class='user-colum-board'>
  <% if users %>
    <% users.each do |user| %>
      <%= link_to user_path(user.id) do %>
        <% unless user.undefined? %>
          <div class='user-column z-depth-3'>
            <%= user_icon(user, size: 'middle') %>
            <div class='user-column-body'>
              <h5><%= user.name %></h5>
              <div class='user-status'>
              </div>
              <div class='user-belong'>
                <%= user_definiton(user) %>
              </div>
            </div>
          </div>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
</div>
