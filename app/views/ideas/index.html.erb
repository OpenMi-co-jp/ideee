<div class='idea-index'>
  <div class='board'>
    <% unless current_user %>
      <div class='full-pic'>
        <%= link_to(
          'ideeeとは',
          '#modal_intro',
          data: { turbolinks: false },
          class: 'waves-effect waves-white white orange-action btn modal-trigger turorial-button',
          id: 'modal-trigger-intro'
        )%>
        <%= link_to '登録する', new_user_session_path, class: 'waves-effect btn orange-action-back new-user-button' %>
      </div>
      <div id="modal_intro" class="modal">
        <div class="modal-content">
          <h4>アイデアとエンジニアのマッチングサイト</h4>
          <p><b>アイデアマン：</b>身の回りで困ってることや「あったらいいな」をエンジニアに投げかけることができる</p>
          <p><b>エンジニア：</b>需要のあるアイデアが手に入り、人助けができる</p>
        </div>
        <div class="modal-footer">
          <%= link_to 'もっと見る', "https://naruhero.site/blog/7", class: 'waves-effect waves-orange orange lighten-2 btn', target: :_blank %>
        </div>
      </div>
    <% end %>
    <%= render 'ideas/index/latest_boad' %>
    <div class="row">
      <div class="col s12 l8">
        <%= render 'ideas/index/social_good' %>
      </div>
      <div class="user-board col s12 l4 gray-1-back pl-3">
        <div class='flex mh-3'>
          <p class='icon-mark grid-middle'>🔥</p>
          <b class='board-title'>注目ユーザー</b>
          <%= link_to users_path, class: 'more-info mt-3 flex gray-5' do %>
            <i class="material-icons">chevron_right</i>もっと見る
          <% end %>
        </div>
        <%= render 'common/partial_users', users: @featured_users %>
      </div>
    </div>
    <div class="row">
      <div class="col s12 l8">
        <%= render 'ideas/index/most_viewed' %>
      </div>
      <div class="col l12">
      </div>
    </div>
    <%= render 'common/service_fund' %>
  </div>
</div>
