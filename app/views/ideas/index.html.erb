<div class='idea-index'>
  <div class='board'>
    <% unless current_user %>
      <div class="full-pic <%= 'show' unless current_user %>">
        <div class='top-page-before-login row'>
          <div class='orange-text'>
            あなたのアイデアを<br/>
            エンジニアと盛り上げる
          </div>
          <div class='mh-4'>
            <%= link_to(
              'ideeeとは',
              '#modal_intro',
              data: { turbolinks: false },
              class: 'waves-effect waves-white white orange-action btn modal-trigger turorial-button',
              id: 'modal-trigger-intro'
            )%>
            <%= link_to '登録する', new_user_registration_path, class: 'waves-effect btn orange-action-back new-user-button' %>
          </div>
          <span class='gray-4'>現在のアイデア数：</span>
          <span class='orange-text'><%= Idea.all.length %></span>
        </div>
      </div>
      <div id="modal_intro" class="modal">
        <div class="modal-content">
          <h4>アイデアとエンジニアのマッチングサイト</h4>
          <p><b>アイデアマン：</b>身の回りで困ってることや「あったらいいな」をエンジニアに投げかけることができる</p>
          <p><b>エンジニア：</b>需要のあるアイデアが手に入り、人助けができる</p>
        </div>
        <div class="modal-footer">
          <%= link_to 'もっと見る', about_path, class: 'waves-effect waves-orange orange lighten-2 btn' %>
        </div>
      </div>
    <% end %>
    <%= render 'ideas/index/latest_boad', title: '最新アイデア', ideas: @latest_ideas %>
    <div class="row">
      <div class="col s12 l8">
        <div class="index-rank">
          <%= render 'ideas/index/ranking_head',
            icon_mark: '💬',
            board_title: '今月のコメントが多いアイデア',
            path: search_ideas_path("q[s]": "comments_num desc") %>
          <%= render_async most_comment_ideas_path %>
          <%= render 'ideas/index/ranking_head',
            icon_mark: '💛',
            board_title: '今月のハートが多いアイデア',
            path: search_ideas_path %>
          <%= render_async most_liked_ideas_path %>
        </div>
      </div>
      <div class="col s12 l4">
        <%= render_async tags_popular_path %>
        <%= render 'ideas/index/featured_users',
          icon: '🚀',
          title: '今週の注目コメンテーター',
          path: search_users_path("q[s]": "point desc"),
          users_url: commenter_users_path %>
        <%= render 'ideas/index/featured_users',
          icon: '💡',
          title: '今月の注目アイデアマン',
          path: search_users_path("q[s]": "ideas_num desc"),
          users_url: idea_man_users_path %>
      </div>
    </div>
    <div class="row">
      <div class="col s12 l8">
        <div class="index-rank">
          <%= render 'ideas/index/ranking_head',
            icon_mark: tag.i('groups', class: 'material-icons'),
            board_title: 'チーム開発募集中のアイデア',
            path: search_ideas_path("q[team_status_eq]": 0) %>
          <%= render_async team_active_ideas_path %>
          <%= render 'ideas/index/ranking_head',
            icon_mark: tag.i('check_circle', class: 'material-icons'),
            board_title: '実現したアイデア',
            path: search_ideas_path("q[product_apply_eq]": 2) %>
          <%= render_async deployed_ideas_path %>
        </div>
      </div>
    </div>
    <% unless current_user %>
      <div class="concept">
        <div class="concept_bg <%= 'show' unless current_user %>">
          <div class="concept_title">
            <p>CONCEPT</p>
          </div>
          <div class="concept_headline">
            <p>アイデアをデザインし、</p>
            <p>エンジニアの出会いを</p>
            <p>盛り上げる</p>
          </div>
          <div class="el_word">
            <p><span>i</span>dea</p>
            <p><span>d</span>esign</p>
            <p><span>e</span>ngineer</p>
            <p><span>e</span>ncounter</p>
            <p><span>e</span>ncourage</p>
          </div>
          <div class="main_copy">
            <p>
              「社会の役に立ちそう」「あると助かるな」を投稿<br>
              サービスの需要を視覚化、市場調査をした上で開発ができる<br>
              <br>
              あなたの「困ってる」を形に<br>
              コードで社会に貢献してみませんか？
            </p>
          </div>
        </div>
      <% end %>
    </div>
    <%= render 'common/service_fund' %>
  </div>
</div>
