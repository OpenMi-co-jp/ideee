<div class='user-colum-board'>
  <% if users %>
    <% users.each do |user| %>
      <%= link_to user_path(user.id) do %>
        <% unless user.undefined? %>
          <div class='user-column border-line'>
            <%= user_icon(user, size: 'middle') %>
            <div class='user-column-body'>
              <div class='user-name-point'>
                <h5><%= user.name %></h5>
                <div class='user-point grid-middle'>
                  <p>🔥</p>
                  <%= user.point %>
                </div>
              </div>
              <%= user_definiton(user) %>
            </div>
          </div>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
</div>
