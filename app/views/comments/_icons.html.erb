<div class='comment-icons'>
  <%= link_to '#', data: { target: "dropdown_comment-#{comment.id}" }, class:'dropdown-trigger white-text' do %>
    <i class="material-icons">delete</i>
  <% end %>
  <ul id="dropdown_comment-<%= comment.id %>" class='dropdown-content comment-option'>
    <li>
      <%= link_to comment_path(comment), method: :delete, id: 'comment-delete' do %>
        削除
      <% end %>
    </li>
  </ul>
</div>
