<%= form_with(model: team, multipart: true, local: false) do |form| %>
  <% if team.errors.any? %>
    <div id="error_explanation">
      <ul>
        <% team.errors.each do |error| %>
          <h4>
            <li><%= error.full_message %></li>
          </h4>
        <% end %>
      </ul>
    </div>
  <% end %>
  <div class='c-team-form'>
    <div class='c-team-form__idea_img'>
      <%= image_set(@idea) %>
    </div>
    <div class='c-team-form__idea-content'>
      <div class="field input-field">
        <%= form.text_area :offer, placeholder: 'チーム開発に参加すると◯◯を得ることができます！', data: { length: 255 }, class: 'validate materialize-textarea', required:'required' %>
        <%= form.label :offer, class: 'required active' %>
        <span class="helper-text" data-error="得られることを入力してください。"></span>
      </div>
      <div class="field input-field">
        <%= form.text_area "requirement", placeholder: 'チームの中で〇〇をお願いしたいです。', data: { length: 255 }, class: 'validate materialize-textarea', required:'required' %>
        <%= form.label :requirement, class: 'required active' %>
        <span class="helper-text" data-error="お願いしたいことを入力してください。"></span>
      </div>
      <%= form.hidden_field :idea_id, value: params[:idea_id] || @idea.id %>
      <%= form.hidden_field :owner_id, value: @idea.user_id %>
      <%= form.hidden_field :status %>
    </div>
    <div class='c-team-form__btns'>
      <% if @team.id.nil? %>
        <%= link_to t('default.team.cancel'), idea_path(@idea), class: 'btn gray-3-back' %>
        <%= form.submit class: 'btn orange-action-back mh-3' %>
      <% else %>
        <%= form.submit class: 'btn orange-action-back mh-3', data: { confirm: '参加者がいる場合、メンバーに通知がいきます。' } %>
      <% end %>
    </div>
  </div>
<% end %>
