<div class="comment-board yellow-soft-back ph-1">
  <h4 class='mw-2'>コメント</h4>
  <% if object.comments.length > 0 %>
    <% object.comments.each_with_index do |comment, i| %>
      <% if current_user&.own?(comment) %>
        <div class='parent'>
          <%= link_to '#', data: { target: "dropdown_comment-#{i}" }, class:'dropdown-trigger' do %>
            <%= render 'comments/unit_comment', owned: true, comment: comment %>
          <% end %>
          <ul id="dropdown_comment-<%=i%>" class='dropdown-content comment-option'>
            <li>
              <%= link_to comment_path(comment), method: :delete, id: 'comment-delete' do %>
                <i class="material-icons">delete</i>削除
              <% end %>
            </li>
          </ul>
        </div>
      <% else %>
        <%= render 'comments/unit_comment', owned: false, comment: comment %>
      <% end %>
    <% end %>
  <% else %>
    <h6 class='mw-2 pt-2'>気になることや、おうえんのコメントをしよう！</h6>
  <% end %>
  <div id='js-comments'></div>
</div>
