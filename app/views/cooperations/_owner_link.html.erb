<% if idea.cooperation_not_started? %>
  <%= link_to t('default.cooperation_start'), cooperation_start_confirm_idea_path(idea), class: 'waves-effect waves-light btn-large orange darken-4'%>
<% elsif idea.cooperation_ongoing? %>
  <%= link_to(
    t('default.cooperation_complete'),
    '#modal_cooperation_complete',
    data: { turbolinks: false },
    class: 'waves-effect waves-light btn-large orange darken-4 modal-trigger',
    id: 'modal-trigger-cooperation-complete',
  )%>
  <%= render 'cooperations/modal',
    modal_id: 'modal_cooperation_complete',
    heading: '募集を終了しますか？',
    name: t('default.cooperation_complete'),
    path: cooperation_complete_idea_path(idea),
    method: :post,
    color: 'orange darken-4'
  %>
<% elsif idea.cooperation_completed? %>
  <%= link_to(
    t('default.cooperation_restart'),
    '#modal_cooperation_restart',
    data: { turbolinks: false },
    class: 'waves-effect waves-light btn-large orange darken-4 modal-trigger',
    id: 'modal-trigger-cooperation-restart',
  )%>
  <%= render 'cooperations/modal',
    modal_id: 'modal_cooperation_restart',
    heading: '開発者を再募集しますか？',
    name: t('default.cooperation_restart'),
    path: cooperation_restart_idea_path(idea),
    method: :post,
    color: 'orange darken-4'
  %>
<% end %>

