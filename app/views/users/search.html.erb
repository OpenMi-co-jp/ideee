<div class='c-search'>
  <%= search_form_for @q, url: search_users_path, method: :get, id: 'js-search-form' do |f| %>
    <div class='c-search__condition'>
      <div class='c-search__name'>
        <%= f.search_field :name_or_description_cont, placeholder: 'ユーザーを検索' %>
      </div>
      <div class='row mt-3'>
        <div class='col s3 m2 l2'>
          <%= f.label :definition %>
        </div>
        <div class='col s9 m10 l10'>
          <% User.definitions.each do |definition| %>
            <label>
              <%= f.check_box :definition_eq_any, { multiple: true, include_hidden: false, class: 'js-search-fire' }, definition[1] %>
              <span><%= I18n.t("enums.user.definition.#{definition[0]}") %></span>
            </label>
          <% end %>
        </div>
      </div>
    </div>
    <div class='c-search__result row'>
      <div class='col s12 m3 l4'>
        <h1 class='board-title mh-3'>検索結果 <%= @searched_users.size %>件</h1>
      </div>
      <div class='col s12 m9 l8 row'>
        <span class='mr-3'>並び替え</span>
        <% I18n.t('activerecord.sorts.users').each do |(key, value)| %>
          <div class="chip">
            <%= sort_link(@q, key, value) %>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>
  <div class='c-search__items'>
    <% if @searched_users.present? %>
      <%= render 'common/partial_users', users: @paged_users %>
      <%= paginate @paged_users %>
    <% else %>
      <h4>検索に合致するアイデアが⾒つかりませんでした</h4>
      <h5><%= link_to "あなたのアイデアを投稿しませんか？", new_idea_path %></h5>
    <% end %>
  </div>
</div>
