<div class='row gray-4'>
  <div class='col l10'>
    <div class='row'>
      <p class='col l6 grid-middle'>
        <%= user_definiton(idea.user) %>
      </p>
      <div class='col l6 flex'>
        <%= link_to user_path(idea.user.id) do %>
          <% user_icon(idea.user, size: 'small') %>
        <% end %>
        <p class='grid-middle'>
          <%= idea.user.name %>
        </p>
      </div>
    </div>

    <div class='c-pc-status-info'>
      <div class="c-pc-status-info__day">
        <%= "更新日：#{l idea.updated_at}" %>
      </div>
      <div class="c-pc-status-info__eye">
        <%= image_tag 'icons/eye.svg' %>
        <%= idea.view %>
      </div>
      <div class='c-pc-status-info__comment', id="comments_count">
        <%= image_tag 'icons/comment.svg' %>
        <p><%= idea.comments_num %></p>
      </div>
      <div class="c-pc-status-info__vote <%= idea.difficulty %>">
        <%= render 'difficultys/vote', object: idea %>
      </div>
      <% if current_user&.own?(idea) %>
        <div class='c-pc-status-info__time'>
          <%= "平均ページ滞在時間: #{Time.at(time_on_page.to_i).utc.strftime('%X')}" %>
        </div>
      <% end %>
    </div>
    <%= render 'tags/links', object: idea %>
  </div>
  <div class='col l2 flex-end'>
    <%= render "common/like", object: idea %>
  </div>
</div>
