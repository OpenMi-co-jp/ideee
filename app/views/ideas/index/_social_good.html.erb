<div class='boad'>
  <div class='main-board'>
    <div class='title-colum'>
      <p class='icon-mark'>😆</p>
      <h3 class='social-good-title'>ソーシャルグッド</h3>
    </div>
    <div class='idea-colum-board'>
      <% if @latest_ideas%>
        <% @latest_ideas.each do |idea| %>
          <div class='idea-column z-depth-3'>
            <%= link_to idea_path(idea.id) do %>
              <div class='idea-picture-column-small'>
                <div class= 'idea-img'>
                  <%= image_set(idea) %>
                </div>
              </div>
            <% end %>
            <div class='idea-column-body'>
              <h5><%= idea.name %></h5>
              <div class='idea-status'>
                <%= "投稿日：#{idea.created_time}" %>
                <%= idea.view %>
              </div>
              <div class='idea-belong'>
                <%= idea.user.name %>
              </div>
            </div>
          </div>
        <% end %>
      <% end %>
    </div>
  </div>
</div>
