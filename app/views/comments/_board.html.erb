<div class="p-comment-board yellow-soft-back ph-1">
  <h4 class='p-comment-board__title'>コメント</h4>
  <% if object.comments_num > 0 %>
    <% object.comments.includes([:user, :reactions]).each do |comment| %>
      <div class="p-comment-board__item <%= 'own-comment' if current_user&.own?(comment) %>" id="comment-<%= comment.id %>">
        <%= render 'comments/unit_comment', owned: current_user&.own?(comment), comment: comment %>
      </div>
    <% end %>
  <% else %>
    <h6 class='mw-4 pt-2'>気になることや、おうえんのコメントをしよう！</h6>
  <% end %>
  <div id='js-comments'></div>
</div>
