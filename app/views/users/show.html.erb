<div class='user-show'>
  <div class="row">
    <div class="col s12 l3">
      <div class="user-type-column">
        <div class='mh-3'><%= user_icon(@user, size: 'large') %></div>
        <h4 class='mh-3'><%= @user&.name %></h4>
        <h5><%= @user&.point %></h5>
        <p class='gray-3'>Contributions</p>
        <p class='gray-3 mh-3'><%= "作成日：#{l @user.created_at}" %></p>
      </div>
      <div class='user-urls'>
        <div class="share-box">
          <% if @user&.twitter_id.present? %>
            <%= link_to twitter_url(@user&.twitter_id), target: '_blank', rel: 'nofollow noopener noreferrer' do %>
              <svg class="twitter-share" version="1.1" id="Layer_1" xmlns="http://www.w3.org/2000/svg" x="0px" y="0px"
                   viewBox="0 0 400 400" style="enable-background:new 0 0 400 400;" xml:space="preserve">
                <g id="Dark_Blue">
                  <circle class="st0" cx="200" cy="200" r="200"/>
                </g>
                <g id="Logo__x2014__FIXED">
                  <path class="st1" d="M163.4,305.5c88.7,0,137.2-73.5,137.2-137.2c0-2.1,0-4.2-0.1-6.2c9.4-6.8,17.6-15.3,24.1-25
		c-8.6,3.8-17.9,6.4-27.7,7.6c10-6,17.6-15.4,21.2-26.7c-9.3,5.5-19.6,9.5-30.6,11.7c-8.8-9.4-21.3-15.2-35.2-15.2
		c-26.6,0-48.2,21.6-48.2,48.2c0,3.8,0.4,7.5,1.3,11c-40.1-2-75.6-21.2-99.4-50.4c-4.1,7.1-6.5,15.4-6.5,24.2
		c0,16.7,8.5,31.5,21.5,40.1c-7.9-0.2-15.3-2.4-21.8-6c0,0.2,0,0.4,0,0.6c0,23.4,16.6,42.8,38.7,47.3c-4,1.1-8.3,1.7-12.7,1.7
		c-3.1,0-6.1-0.3-9.1-0.9c6.1,19.2,23.9,33.1,45,33.5c-16.5,12.9-37.3,20.6-59.9,20.6c-3.9,0-7.7-0.2-11.5-0.7
		C110.8,297.5,136.2,305.5,163.4,305.5"/>
                </g>
              </svg>
            <% end %>
          <% else %>
            <svg class="twitter-share gray" version="1.1" id="Layer_1" xmlns="http://www.w3.org/2000/svg" x="0px" y="0px"
                 viewBox="0 0 400 400" style="enable-background:new 0 0 400 400;" xml:space="preserve">
              <g id="Dark_Blue">
                <circle class="st0" cx="200" cy="200" r="200"/>
              </g>
              <g id="Logo__x2014__FIXED">
                <path class="st1" d="M163.4,305.5c88.7,0,137.2-73.5,137.2-137.2c0-2.1,0-4.2-0.1-6.2c9.4-6.8,17.6-15.3,24.1-25
		c-8.6,3.8-17.9,6.4-27.7,7.6c10-6,17.6-15.4,21.2-26.7c-9.3,5.5-19.6,9.5-30.6,11.7c-8.8-9.4-21.3-15.2-35.2-15.2
		c-26.6,0-48.2,21.6-48.2,48.2c0,3.8,0.4,7.5,1.3,11c-40.1-2-75.6-21.2-99.4-50.4c-4.1,7.1-6.5,15.4-6.5,24.2
		c0,16.7,8.5,31.5,21.5,40.1c-7.9-0.2-15.3-2.4-21.8-6c0,0.2,0,0.4,0,0.6c0,23.4,16.6,42.8,38.7,47.3c-4,1.1-8.3,1.7-12.7,1.7
		c-3.1,0-6.1-0.3-9.1-0.9c6.1,19.2,23.9,33.1,45,33.5c-16.5,12.9-37.3,20.6-59.9,20.6c-3.9,0-7.7-0.2-11.5-0.7
		C110.8,297.5,136.2,305.5,163.4,305.5"/>
              </g>
            </svg>
          <% end %>
        </div>
        <div class="share-box grid-middle">
          <% if @user.site_url.present? %>
            <%= link_to @user.site_url, target: '_blank', rel: 'nofollow noopener noreferrer' do %>
              <i class="material-icons medium orange-soft">link</i>
            <% end %>
          <% else %>
            <i class="material-icons small gray-3">link</i>
          <% end %>
        </div>
      </div>
    </div>
    <div class="col s12 l9">
      <div class="">
        <div class="row">
          <div class="col s10">
            <%= user_definiton(@user) %>
          </div>
        </div>
      </div>
      <% if @user.description.present? %>
        <div class="user-content mb-2">
          <%== simple_format(text_url_to_link(@user.description), {}, sanitize: false) %>
        </div>
      <% end %>
      <% if own_user_checked(@user) %>
        <%= link_to '編集', edit_user_registration_path(@user.id), class: 'mw-3' %>
      <% end %>
    </div>
  </div>
  <div class="row">
    <div class="col s12 <%= own_user_checked(@user) ? 'l8' : 'l12' %>">
      <% if @user.ideas.published.present? %>
        <h4>アイデア</h4>
        <%= render 'common/column_board', ideas: @user.ideas.published %>
      <% else %>
        <h4 class='no_idea_posted'>まだアイデアが投稿されていません</h4>
      <% end %>
    </div>
    <% if own_user_checked(@user) %>
      <div class="col s12 l4">
        <% if @user.ideas.drafts.present? %>
          <h4>下書きアイデア</h4>
          <%= render 'common/simple_board', ideas: @user.ideas.drafts %>
        <% else %>
          <h5 class='no_draft_posted'>まだ下書きがありません</h5>
          <p class='gray-3'>※下書きはあなたにしか見えません</p>
        <% end %>
      </div>
    <% end %>
  </div>
  <%= render 'common/fund_link', object: @user %>
  <%= render 'users/show/lead_to_post' if own_user_checked(@user) %>
</div>
