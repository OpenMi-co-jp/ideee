<%# TODO: user_listに統合 %>
<div class='user-colum-board p-1'>
  <% if users %>
    <% users.each.with_index(@rank_num) do |user, i| %>
      <div class='row'>
        <h5 class='italic col ml-2'>
          <%= i+1 %>
        </h4>
        <%= link_to user_path(user.id) do %>
          <div class='user-column border-line'>
            <div class='user-column-inside flex'>
              <%= user_icon(user) %>
              <div class='user-column-body'>
                <div class='user-name-point'>
                  <div>
                    <div class='user-name orange-action'><%= user.name %></div>
                    <div class='flex'>
                      <%= user_definiton(user, ver='short') %>
                      <div class='row-user__ideas'>
                        <%= image_tag 'icons/idea.svg', class: 'icon-size', loading: "lazy" %><%= user.ideas.published.size, alt: "アイデアアイコン"%>
                      </div>
                    </div>
                  </div>
                  <div class='user-point grid-middle'>
                    <% if users.length == t('default.users.weekly_comments_num') %>
                      <p>💬</p>
                      <%= @commented_users_array.to_h[user.id] %>
                    <% elsif users.length == t('default.users.monthly_publisher_num') %>
                      <p>💡</p>
                      <%= @idea_publisher_array.to_h[user.id] %>
                    <% else %>
                      <p>🔥</p>
                      <%= user.point %>
                    <% end %>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    <% end %>
  <% end %>
</div>
