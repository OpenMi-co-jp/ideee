<div class='center'>
  <% if idea.team&.status_active? || idea.draft %>
    <div class='c-team-box__status'>
      <%= I18n.t("enums.idea.teams.#{idea.team&.status}") %>
    </div>
  <% end %>
  <% unless idea.draft %>
    <div class='c-team-box__apply'>
      <% if current_user&.own?(idea) %>
        <%= render 'teams/owner_link', idea: idea %>
      <% else %>
        <%= render 'teams/link', idea: idea %>
      <% end %>
      <%= render 'teams/members', users: idea.team&.members %>
    </div>
  <% end %>
</div>
