<div class='idea'>
  <% ideas.each.with_index(@rank_num || 0) do |idea, i| %>
    <div class='idea__list'>
      <h5 class='idea__num'>
        <%= i + 1 %>
      </h5>
      <div class='idea__content'>
        <%= link_to idea_path(idea.id), class: 'idea__img' do %>
          <figure>
            <%= image_set(idea) %>
          </figure>
        <% end %>
        <div class='idea__box'>
          <%= link_to idea_path(idea.id) do %>
            <b class='idea__name orange-action'><%= idea.name %></b>
          <% end %>
          <div class='idea__status gray-3'>
            <p class=''><%= "投稿日 #{idea.created_time}" %></p>
            <div class='idea__comments'>
              <%= image_tag 'icons/comment.svg', class: 'icon-size gray-4' %>
              <p class='gray-5 ml-2'><%= idea.comments.length %></p>
            </div>
            <div class='idea__eyes'>
              <%= image_tag 'icons/eye.svg', class: 'icon-size gray-4' %>
              <p class=' gray-5 ml-1'><%= idea.view %></p>
            </div>
            <div class="idea__detail pc">
              <%= link_to user_path(idea.user.id), class: '' do %>
                <% user_icon(idea.user, size: 'small') %>
              <% end %>
              <p class='idea__detail--def'>
                <%= user_definiton(idea.user, ver = 'short') %>
              </p>
            </div>
          </div>
        </div>
        <div class='idea__info'>
          <div class="idea__detail sp">
            <%= link_to user_path(idea.user.id), class: '' do %>
              <% user_icon(idea.user, size: 'small') %>
            <% end %>
            <p class='idea__detail--def'>
              <%= user_definiton(idea.user, ver = 'short') %>
            </p>
          </div>
          <div class='idea__like'>
            <%= render "common/like", object: idea %>
          </div>
        </div>
      </div>
    </div>
  <% end %>
</div>
