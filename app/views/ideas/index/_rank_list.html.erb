<div class='idea'>
  <% ideas.each do |idea| %>
    <div class='idea__list'>
      <div class='idea__content'>
        <%= link_to idea_path(idea.id), class: 'idea__img' do %>
          <figure>
            <%= image_set(idea) %>
          </figure>
        <% end %>
        <div class='idea__box'>
          <%= link_to idea_path(idea.id), class: 'idea__name_link' do %>
            <b class='idea__name orange-action'><%= idea.name %></b>
          <% end %>
          <div class='idea__status gray-3'>
            <div class='idea__time'>
              <%= embedded_svg 'icons/clock.svg', class: 'icon-size gray-4 idea__time--clock' %>
              <p><%= idea.published_time %></p>
            </div>
            <div class='idea__item'>
              <%= image_tag 'icons/comment.svg', class: 'icon-size', loading: "lazy" %>
              <p><%= idea.comments_num %></p>
            </div>
            <div class='idea__item'>
              <%= image_tag 'icons/eye.svg', class: 'icon-size', loading: "lazy" %>
              <p><%= idea.view %></p>
            </div>
            <div class='idea__item'>
              <%= image_tag 'like-heart.svg', class: 'icon-size', loading: "lazy" %>
              <p><%= idea.likes_num %></p>
            </div>
            <div class="idea__detail pc">
              <div class="idea__detail--vote <%= idea.difficulty %>">
                <%= difficulty_tag(idea) %>
              </div>
              <%= link_to user_path(idea.user_id), class: '' do %>
                <% user_icon(idea.user, size: 'small') %>
              <% end %>
            </div>
          </div>
          <%= render 'tags/links', object: idea %>
        </div>
        <div class='idea__info'>
          <div class="idea__detail sp">
            <div class="idea__detail--vote <%= idea.difficulty %>">
              <%= difficulty_tag(idea) %>
            </div>
            <%= link_to user_path(idea.user_id), class: '' do %>
              <% user_icon(idea.user, size: 'small') %>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  <% end %>
</div>
