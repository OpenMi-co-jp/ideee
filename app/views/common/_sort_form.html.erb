<%= form_with url: path, method: :get, id: 'js-search-form' do |f| %>
  <div class="row">
    <div class='input-field col s12 m6'>
      <%= f.select :sort, options_for_select(idea_sort_hash, selected: @sort ), {}, class: 'js-search-fire' %>
    </div>
    <div class='input-field col s12 m6'>
      <%= f.select :order, options_for_select(idea_order_hash, selected: @order ), {}, class: 'js-search-fire' %>
    </div>
    <%= f.hidden_field :keyword, value: keyword %>
  </div>
<% end %>
