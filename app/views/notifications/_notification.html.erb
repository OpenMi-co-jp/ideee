<div class="p-notification__container">
  <div class="p-notification__user_icon">
    <%= link_to user_path(id: notification.visitor_id) do %>
      <%= user_icon(notification.visitor, size: 'small') %>
    <% end %>
  </div>
  <div class="p-notification__message">
    <%= link_to "#{truncate(notification.visitor.name)}", user_path(id: notification.visitor_id), class: "p-notification__message--link" %>
      さんが
    <%= link_to "#{truncate(notification.idea&.name)}", idea_path(id: notification.idea_id), class: "p-notification__message--link" %>
    <%= t("notifications.#{notification.notificatable_type}") %>
    <%= content_tag(:p, "#{l notification.created_at, format: :long }", class: "p-notification__message--date") %>
  </div>
</div>
<li class="divider" tabindex="-1"></li>
