<% if idea.cooperation_not_started? %>
  <%= link_to t('default.cooperation.start'), start_confirm_cooperations_path(idea_id: idea), class: 'btn orange-action-back'%>
<% elsif idea.cooperation_ongoing? %>
  <%= link_to(
    t('default.cooperation.complete'),
    '#modal_cooperation_complete',
    data: { turbolinks: false },
    class: 'btn orange-action-back modal-trigger',
    id: 'modal-trigger-cooperation-complete',
  )%>
  <%= render 'cooperations/modal',
    modal_id: 'modal_cooperation_complete',
    heading: '募集を終了しますか？',
    name: t('default.cooperation.complete'),
    path: complete_cooperations_path(idea_id: idea),
    method: :post,
    message: nil
  %>
<% elsif idea.cooperation_completed? %>
  <%= link_to(
    t('default.cooperation.restart'),
    '#modal_cooperation_restart',
    data: { turbolinks: false },
    class: 'btn orange-action-back modal-trigger',
    id: 'modal-trigger-cooperation-restart',
  )%>
  <%= render 'cooperations/modal',
    modal_id: 'modal_cooperation_restart',
    heading: '開発者を再募集しますか？',
    name: t('default.cooperation.restart'),
    path: restart_cooperations_path(idea_id: idea),
    method: :post,
    message: nil
  %>
<% end %>

