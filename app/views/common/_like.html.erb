<% if current_user && !current_user.own?(object) %>
  <%= render 'common/like_link', object: object %>
<% else %>
  <%= link_to '#modal_before_login', data: { turbolinks: false }, class: "modal-trigger-login #{own_object?(object)}" do %>
    <div class='likes-column btn orange'>
        <%= embedded_svg "like-heart.svg", class:'idea-likes', alt: 'いいね数' %>
        <%= object.likes.length %>
    </div>
  <% end %>
<% end %>
