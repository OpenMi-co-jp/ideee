    <h5 class='board-title orange-action'><%= board_title %></h5>
    <%= link_to path, class: 'more-info mt-3 flex gray-5' do %>
      <i class="material-icons">chevron_right</i>もっと見る
    <% end %>
  </div>
  <%= render 'common/column_board', ideas: ideas %>
