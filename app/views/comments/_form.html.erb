<div class="comment-forms row mh-3">
  <% if current_user %>
    <div class="comment-form">
      <textarea class='comment-area yellow-soft-back mh-3' id="comment-form" placeholder='コメントする'></textarea>
      <div id="comment_message"></div>
    </div>
    <div class='comment-btn'>
      <%= link_to "#!",
        id: "comment",
        class: "submit-btn waves-effect btn orange-action-back nav-link" do %>
        <b class='white-text'><%= t('default.submit') %></b>
      <% end %>
    </div>
  <% else %>
    <div class='comment-btn'>
      <%= link_to "#modal_before_login",
        data: { turbolinks: false },
        class: "modal-trigger-login submit-btn waves-effect btn orange-action-back nav-link" do %>
        <b class='white-text'><%= t('default.comment') %></b>
      <% end %>
    </div>
  <% end %>
</div>
