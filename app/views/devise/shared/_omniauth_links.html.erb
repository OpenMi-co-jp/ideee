<%- if devise_mapping.omniauthable? %>
  <%- resource_class.omniauth_providers.each do |provider| %>
    <%= link_to omniauth_authorize_path(resource_name, provider), method: :post, class: "omniauth-btn" do %>
      <div class="sign-up-box z-depth-1 omniauth-sign-up">
        <%= omni_sign_image(provider) %>
        <%= omni_sign_word %>
      </div>
    <% end %>
  <% end %>
<% end %>
