<div class='latest-boad'>
  <h1>ユーザー情報</h1>
  <table>
      <thead>
        <tr class='mb-3'>
          <th>Icon</th>
          <th>Name</th>
          <th>Email</th>
          <th>作られた日</th>
          <th>Type</th>
          <th colspan="3"></th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td><%= user_icon(@user) %></td>
          <td><%= checked(@user.name) %></td>
          <td><%= checked(@user.email) %></td>
          <td><%= @user.created_at %></td>
          <td><%= twitter_url(checked(@user.twitter_id)) %></td>
          <% @user.ideas.each do |i| %>
            <td><%= i.name %></td>
          <% end %>
          <td><%= link_to 'Edit', edit_user_registration_path(@user.id) %></td>
          <td><%= link_to 'Destroy', user_registration_path(@user.id), method: :delete, data: { confirm: 'Are you sure?' } %></td>
        </tr>
      </tbody>
    </table>
</div>
