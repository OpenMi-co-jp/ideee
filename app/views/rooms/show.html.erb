<div class="p-room">
  <div class="p-room__head">
    <%= link_to idea_path(@team.idea.id), class: 'c-idea-img', title: "チーム開発中のアイデア" do %>
      <figure class='c-idea-img__figure'>
        <%= image_set(@team.idea) %>
      </figure>
    <% end %>
    <div class="p-room__head--body">
      <h1 class='p-room__head--body__title'><%= @team.idea.name %></h1>
      <div class='p-room__head--body__team'>
        <%= render 'teams/show/user_list', team: @team %>
      </div>
    </div>
  </div>
  <%= render 'comments/board', items: @messages, item_class: 'messages' %>

  <div class="p-room__input">
    <%= form_with(model: @message, url: messages_path(room_id: @room.id), local: false) do |form| %>
      <%= form.rich_text_area :content, placeholder: 'メッセージを送る' %>
      <div class='c-comment-form__btn-area'>
        <%= form.submit t('default.submit'), class: 'btn orange-action-back mh-3 idea-btn' %>
      </div>
    <% end %>
  </div>
</div>
