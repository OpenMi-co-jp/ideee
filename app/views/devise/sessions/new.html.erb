<div class="sign-form row">
  <div class="col s12 l6">
    <h2 class='orange-action'>ideee</h2>
    <p class='gray-5 mb-3'>アイディー</p>
    <p>Ideaを</p>
    <p>Designし</p>
    <p>Engineerが</p>
    <p>Encounter(出会い)を</p>
    <p>Encourage(盛り上げる)</p>
    <%= render "devise/shared/twitter_share" %>
  </div>
  <div class="col s12 l6">
    <h2><%= t 'default.login' %></h2>
    <%= render "devise/shared/omniauth_links" %>
    <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
      <div class="field input-field">
        <%= f.email_field :email, autofocus: true, autocomplete: "email", placeholder: 'ideee@example.com', class: 'validate', required:'required' %>
        <%= f.label :email, class: 'active'  %><br />
        <span class="helper-text" data-error="正しい形式のメールアドレスを入力してください。"></span>
      </div>

      <div class="field input-field">
        <%= f.password_field :password, autocomplete: "current-password", placeholder: 'password', class: 'validate', data: { 'min-length': @minimum_password_length } %>
        <%= f.label :password, class: 'active'  %><br />
        <%= password_helper_text %>
      </div>

      <%# TODO: rememberableを設定 %>
      <!---
      <% if devise_mapping.rememberable? %>
        <div class="field">
          <%= f.check_box :remember_me %>
          <%= f.label :remember_me %>
        </div>
      <% end %>
      --->

      <%= f.submit t('default.login'), class: 'btn orange-action-back mh-1' %>
    <% end %>

    <%= render "devise/shared/links" %>
  </div>
</div>
