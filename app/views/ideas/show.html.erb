<%# OGP %>
<% set_meta_tags og: {
    title: @idea.name,
    image: return_ogp_url(@idea.name),
    description: strip_tags(@idea.note.to_s).gsub(/[\n]/,"").strip.truncate(120)
  } %>

<div class='idea-show'>
  <div class='row'>
    <div class='idea-column-img col s3'>
      <%= image_set(@idea) %>
      <p class='idea-created gray-word'><%= "作成日: #{l @idea.created_at}" %></p>
      <div class="flex">
        <div class="share-box">
          <%= link_to twitter_share(@idea), target: '_blank' do %>
            <%= image_tag "twitter_icon.png", class: "twitter-share small" %>
            <%= tag.p '＼ シェア ／', class: "twitter-share" %>
          <% end %>
        </div>
        <div class="share-box url-copy" onclick="M.toast({html: 'コピーしました', classes: 'orange lighten-4 rounded'})">
          <i class="material-icons">content_copy</i>
          <%= tag.p '＼ コピー ／' %>
        </div>
      </div>
    </div>
    <div class='idea-status-column col s9'>
      <div class='idea-name orange-word'>
        <%= @idea.name %>
      </div>

      <div class='row gray-word'>
        <div class='col s6'>
          <div class='flex'>
            <%= link_to user_path(@idea.user.id) do %>
              <% user_icon(@idea.user, size: 'small') %>
            <% end %>
            <p class='grid-middle'>
              <%= @idea.user.name %>
            </p>
            <p class='grid-middle'>
              <%= user_definiton(@idea.user) %>
            </p>
          </div>

          <div class='flex mh-1'>
            <%= "更新日：#{l @idea.updated_at}" %>
            <div class='flex pl-1'>
              <i class="material-icons">remove_red_eye</i>
              <div class='grid-middle'>
                <%= @idea.view %>
              </div>
            </div>
            <% if current_user&.own?(@idea) %>
              <%= "平均ページ滞在時間: #{Time.at(@time_on_page.to_i).utc.strftime('%X')}" %>
            <% end %>
          </div>
        </div>
        <div class='flex-end'>
          <%= render "common/like", object: @idea %>
        </div>
      </div>

      <div class='idea-content'>
        <% if current_user %>
          <%= @idea.note %>
        <% else %>
          <%= strip_tags(@idea.note.to_s).gsub(/[\n]/,"").strip.truncate(120) %>
        <% end %>
      </div>
    </div>
  </div>

  <% if current_user&.own?(@idea) %>
    <%= link_to '編集', edit_idea_path(@idea) %>
    <%= link_to '削除', idea_path(@idea), method: :delete, data: { confirm: '削除してもよろしいですか？'} %>
  <% end %>
</div>
